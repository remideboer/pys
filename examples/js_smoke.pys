# JavaScript smoke — core teaching surface (no tasks/traits/Python packages).
# Run: python -m transpiler run examples/js_smoke.pys --target javascript
# Also runs under --target python.

print("hello-js")

int n = 2 + 3
print(n)

list<int> arr = [10, 20, 30, 40]
print(arr[1:3])

enum Color {
    Red,
    Green
}
Color c = Color.Red
string label = switch (c) {
    case Color.Red => "red"
    default => "other"
}
print(label)

class Greeter {
    private fix string name

    public constructor(string name) {
        this.name = name
    }

    public string hello() {
        return "hi:" + this.name
    }
}

Greeter g = Greeter("Ada")
print(g.hello())
