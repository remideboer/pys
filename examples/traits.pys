# Traits: reusable behavior via uses + requires (not a nominal type).

trait Printable {
    requires string name

    string label() {
        return "Item: " + this.name
    }
}

trait Comparable {
    requires int compareTo(Product other)

    bool isGreaterThan(Product other) {
        return this.compareTo(other) > 0
    }
}

class Product uses Printable, Comparable {
    private string name
    private float price

    public Product(string name, float price) {
        this.name = name
        this.price = price
    }

    public int compareTo(Product other) {
        if (this.price > other.price) {
            return 1
        }
        return -1
    }
}

Product apple = Product("apple", 1.5)
Product pear = Product("pear", 2.0)
print(apple.label())  # Item: apple
print(apple.isGreaterThan(pear))  # false
print(pear.isGreaterThan(apple))  # true

# --- Collision: two traits define greet; class override disambiguates ---
trait Loud {
    string greet() {
        return "HEY"
    }
}

trait Soft {
    string greet() {
        return "hi"
    }
}

class Greeter uses Loud, Soft {
    public Greeter() {
    }

    public string greet() {
        return Loud.greet(this) + "/" + Soft.greet(this)
    }
}

Greeter g = Greeter()
print(g.greet())  # HEY/hi
