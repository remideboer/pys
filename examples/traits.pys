# Traits: uses + requires (composition, not a nominal type).

# --- requires field: trait reads host state via this ---
trait Printable {
    requires string name

    string label() {
        return "Item: " + this.name
    }
}

# --- requires method: host supplies compareTo; trait builds on it ---
trait Comparable {
    requires int compareTo(Product other)

    bool isGreaterThan(Product other) {
        return this.compareTo(other) > 0
    }

    bool isLessThan(Product other) {
        return this.compareTo(other) < 0
    }
}

class Product uses Printable, Comparable {
    private string name
    private float price

    public Product(string name, float price) {
        this.name = name
        this.price = price
    }

    public int compareTo(Product other) {
        if (this.price > other.price) {
            return 1
        }
        if (this.price < other.price) {
            return -1
        }
        return 0
    }
}

Product apple = Product("apple", 1.5)
Product pear = Product("pear", 2.0)
print(apple.label())  # Item: apple
print(apple.isGreaterThan(pear))  # false
print(pear.isGreaterThan(apple))  # true
print(apple.isLessThan(pear))  # true

# --- Multiple requires (two fields) ---
trait Tagged {
    requires string name
    requires int id

    string tag() {
        return this.name + "#" + this.id
    }
}

class Part uses Tagged {
    private string name
    private int id

    public Part(string name, int id) {
        this.name = name
        this.id = id
    }
}

Part bolt = Part("bolt", 42)
print(bolt.tag())  # bolt#42

# --- requires satisfied by an ancestor field (inherits + uses) ---
class Named {
    private string name

    public Named(string name) {
        this.name = name
    }
}

class Widget inherits Named uses Printable {
    public Widget(string name) {
        super(name)
    }
}

Widget w = Widget("gauge")
print(w.label())  # Item: gauge

# --- Same-trait method call: status() uses isWithinLimit() ---
trait Bounded {
    requires int value
    requires int max

    bool isWithinLimit() {
        return this.value <= this.max
    }

    string status() {
        if (this.isWithinLimit()) {
            return "within limit"
        }
        return "overflow"
    }
}

class Meter uses Bounded {
    private int value
    private int max

    public Meter(int value, int max) {
        this.value = value
        this.max = max
    }
}

Meter m1 = Meter(3, 10)
Meter m2 = Meter(12, 10)
print(m1.status())  # within limit
print(m2.status())  # overflow

# --- Collision: two traits define greet; override picks both via Trait.method(this) ---
trait Loud {
    string greet() {
        return "HEY"
    }
}

trait Soft {
    string greet() {
        return "hi"
    }
}

class Greeter uses Loud, Soft {
    public Greeter() {
    }

    public string greet() {
        return Loud.greet(this) + "/" + Soft.greet(this)
    }
}

Greeter g = Greeter()
print(g.greet())  # HEY/hi

# --- requires remapping: host names differ from trait requires (ADR-009 / CER-027) ---
# label() still called label(); this.name in the trait reads host field `title`.
class CatalogItem uses Printable(name: title) {
    private string title
    private float unitPrice

    public CatalogItem(string title, float unitPrice) {
        this.title = title
        this.unitPrice = unitPrice
    }
}

CatalogItem item = CatalogItem("widget", 9.5)
print(item.label())  # Item: widget
