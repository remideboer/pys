# examples/source_roots — package identity across src/ and tests/ (ADR-017 / F-006)
#
# pys.toml declares [source_roots]. After stripping the root, identical relative
# paths are the same package. No new keyword; no private-bypass for tests.
#
# Run:
#   python -m transpiler run examples/source_roots/tests/billing/InvoiceTest.pys

# --- Production type in package billing (src/billing) ---
# `package` exports are visible to tests/billing/* (mirrored path) without
# making the API `public` / `global`.

package class Invoice {
    # private: implementation detail — tests must not reach in.
    private int cents
    public string customer

    public Invoice(string customer, int cents) {
        this.customer = customer
        this.cents = cents
    }

    # Public / package surface is the contract tests should use.
    public int totalCents() {
        return this.cents
    }

    public void addCents(int more) {
        this.cents = this.cents + more
    }
}

# package function: same visibility rule as package class.
package function string formatInvoice(Invoice inv) {
    return inv.customer + ": " + str(inv.totalCents()) + " cents"
}
