# Mirrored package billing under tests/ — same package as src/billing/*.
#
# Bare import `from Invoice` resolves across source roots (package peers).
# No widening of Invoice to `public` was required for this to compile.

import Invoice, formatInvoice from Invoice

Invoice inv = Invoice("Ada", 100)
inv.addCents(50)
print(formatInvoice(inv))  # Ada: 150 cents

# --- What tests must NOT do ---
# private Invoice.cents is not visible here. If a test "needs" a private field,
# that is a signal to improve the public constructor(query method, result object),
# not a gap for a language bypass — see
# requirements/package_resolution_testing_philosophy.md §§1–2.
#
# --- Wrong folder mistake ---
# tests/test_utils/WrongPlaceTest.pys is intentionally in the wrong package.
# Importing a package symbol from billing fails with pys.package-mismatch and
# suggests moving the file to tests/billing/ (IDE quick fix available).
# See tests/test_utils/WrongPlaceTest.pys (uncomment the explicit-path import).
