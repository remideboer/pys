# Domain entities (shop.sql). Identity keys are fix; other fields may change.
# docs/DATA_ENTITY.md — getters expose keys without making them mutable.

package entity Product identity(productId) {
    protected fix int productId
    public string sku
    public string name
    public float unitPrice
    public bool active
    public string createdAt

    public Product(
        int productId,
        string sku,
        string name,
        float unitPrice,
        bool active,
        string createdAt
    ) {
        this.productId = productId
        this.sku = sku
        this.name = name
        this.unitPrice = unitPrice
        this.active = active
        this.createdAt = createdAt
    }

    public int id() {
        return this.productId
    }

    public string summary() {
        string flag = "active"
        if (this.active == false) {
            flag = "inactive"
        }
        return "#" + str(this.productId) + " " + this.sku + " " + this.name
            + " @" + str(this.unitPrice) + " [" + flag + "]"
    }
}

package entity Order identity(orderId) {
    protected fix int orderId
    public string placedAt
    public string status
    public string customerRef

    public Order(int orderId, string placedAt, string status, string customerRef) {
        this.orderId = orderId
        this.placedAt = placedAt
        this.status = status
        this.customerRef = customerRef
    }

    public int id() {
        return this.orderId
    }

    public string summary() {
        string who = this.customerRef
        if (who == "") {
            who = "(no customer)"
        }
        return "#" + str(this.orderId) + " " + this.placedAt + " status="
            + this.status + " " + who
    }
}

# Composite identity (orderId, lineNumber) — parent key first (DATA_ENTITY.md).

package entity OrderLine inherits Order identity(lineNumber) {
    protected fix int lineNumber
    public int productId
    public string skuSnapshot
    public float unitPrice
    public int quantity

    public OrderLine(
        int orderId,
        string placedAt,
        string status,
        string customerRef,
        int lineNumber,
        int productId,
        string skuSnapshot,
        float unitPrice,
        int quantity
    ) {
        super(orderId, placedAt, status, customerRef)
        this.lineNumber = lineNumber
        this.productId = productId
        this.skuSnapshot = skuSnapshot
        this.unitPrice = unitPrice
        this.quantity = quantity
    }

    public int lineKey() {
        return this.lineNumber
    }

    public string summary() {
        return "order #" + str(this.orderId) + " line " + str(this.lineNumber)
            + " " + this.skuSnapshot + " x" + str(this.quantity)
            + " @" + str(this.unitPrice)
    }

    public float lineTotal() {
        return this.unitPrice * (float) this.quantity
    }
}
