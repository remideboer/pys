# Interfaces: contracts without state or method bodies.
# Vehicle domain shows implements, layered interfaces, and polymorphism.

# --- Interfaces (package: importable from any file in the folder) ---
# Methods are always public and abstract — no access modifier on signatures.
package interface Drivable {
    start()
    move()
    stop()
}

package interface Flyable {
    takeoff()
    land()
}

package interface Loadable {
    load(int weight)
    int capacity()
}

# --- Base class implementing Drivable ---
package class Vehicle implements Drivable {
    protected string make
    protected string model
    protected int year

    # constructor chaining via this(...)
    public constructor(string make, string model) {
        this(make, model, 2024)
    }

    public constructor(string make, string model, int year) {
        this.make = make
        this.model = model
        this.year = year
    }

    public start() {
        print("{this.make} {this.model} starting")
    }

    public open move() {
        print("{this.make} {this.model} moving")
    }

    public stop() {
        print("{this.make} {this.model} stopped")
    }
}

# --- Car: inherits Vehicle (still one interface via the parent) ---
package class Car inherits Vehicle {
    public constructor(string make, string model, int year) {
        super(make, model, year)
    }

    # method overloading
    public override move() {
        print("{this.make} {this.model} ({this.year}) driving")
    }

    public move(string driver) {
        print("{driver} drives {this.make} {this.model}")
    }
}

# --- Truck: Vehicle + Loadable ---
package class Truck inherits Vehicle implements Loadable {
    private int maxLoad

    public constructor(string make, string model, int year, int maxLoad) {
        super(make, model, year)
        this.maxLoad = maxLoad
    }

    public override move() {
        print("{this.make} {this.model} ({this.year}) hauling")
    }

    public load(int weight) {
        print("Loading {weight}kg onto {this.make} {this.model}")
    }

    public int capacity() {
        return this.maxLoad
    }
}

# --- Plane: Vehicle + Flyable ---
package class Plane inherits Vehicle implements Flyable {
    private int altitude

    public constructor(string make, string model, int year) {
        super(make, model, year)
        this.altitude = 0
    }

    public override move() {
        print("{this.make} {this.model} flying at {this.altitude}ft")
    }

    public takeoff() {
        this.altitude = 35000
        print("{this.make} {this.model} taking off")
    }

    public land() {
        this.altitude = 0
        print("{this.make} {this.model} landing")
    }
}

# --- CargoPlane: Plane + Loadable (layered interfaces) ---
package class CargoPlane inherits Plane implements Loadable {
    private int maxLoad

    public constructor(string make, string model, int year, int maxLoad) {
        super(make, model, year)
        this.maxLoad = maxLoad
    }

    public load(int weight) {
        print("Loading {weight}kg into {this.make} {this.model} cargo hold")
    }

    public int capacity() {
        return this.maxLoad
    }
}

# --- Ship: closed — cannot be extended with inherits ---
package closed class Ship inherits Vehicle implements Loadable {
    private int maxLoad

    public constructor(string make, string model, int year, int maxLoad) {
        super(make, model, year)
        this.maxLoad = maxLoad
    }

    public load(int weight) {
        print("Loading {weight}kg onto {this.make} {this.model}")
    }

    public int capacity() {
        return this.maxLoad
    }
}

# module-private helper: not accessible outside this file
function log(string msg) {
    print("interfaces.log: {msg}")
}
