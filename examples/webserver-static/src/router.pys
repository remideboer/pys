import HttpRequest, HttpResponse from http11
import StaticFiles from static_files

package class Router {
    private StaticFiles files

    public constructor(StaticFiles files) {
        this.files = files
    }

    public HttpResponse handle(HttpRequest req) {
        if (req.method != "GET" && req.method != "HEAD") {
            return HttpResponse(405, "Method Not Allowed", "method not allowed", "text/plain; charset=utf-8")
        }
        string absPath = this.files.resolve(req.path)
        if (absPath == "") {
            return HttpResponse(404, "Not Found", "not found", "text/plain; charset=utf-8")
        }
        string body = ""
        if (req.method == "GET") {
            body = this.files.readFile(absPath)
        }
        return HttpResponse(200, "OK", body, this.files.mimeFor(req.path))
    }
}
