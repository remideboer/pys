# examples/concurrency — structured tasks / await / shared (Policy B)
# Prefer task parameters for inputs; shared only for cross-task mutation.

# ── Basic join: tasks block waits for every child ─────────
global function demo_join() {
    print("--- demo_join ---")
    tasks {
        task {
            print("worker A")
        }
        task {
            print("worker B")
        }
        task {
            print("worker C")
        }
    }
    print("all workers finished")
}

# ── Parameters instead of capturing outer inputs ──────────
global function demo_task_params() {
    print("--- demo_task_params ---")
    tasks {
        task show(string label, int seed) {
            print("label=#s{label} seed=#i{seed}")
            return 0
        }
        task {
            int ignored = await show("probe", 7)
        }
    }
}

# ── Local bindings inside a task are fine ─────────────────
global function demo_task_locals() {
    print("--- demo_task_locals ---")
    tasks {
        task {
            int x = 10
            int y = 20
            print("local sum=#i{x}")
            print(y)
        }
    }
}
