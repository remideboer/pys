# Named tasks + await, including parameterized tasks.

global function demo_await_one() {
    print("--- demo_await_one ---")
    tasks {
        task answer {
            return 41
        }
        task {
            int n = await answer
            int next = n + 1
            print("awaited #i{n}, next=#i{next}")
        }
    }
}

global function demo_await_fan_in() {
    print("--- demo_await_fan_in ---")
    tasks {
        task left(int n) {
            return n
        }
        task right(int n) {
            return n
        }
        task {
            int a = await left(10)
            int b = await right(32)
            print("fan-in sum:")
            print(a + b)
        }
    }
}

global function demo_await_chain() {
    print("--- demo_await_chain ---")
    tasks {
        task step1(int n) {
            return n
        }
        task step2(int x) {
            return x * 3
        }
        task {
            int mid = await step1(2)
            int y = await step2(mid)
            print("2 * 3 = #i{y}")
        }
    }
}

global function demo_await_args() {
    print("--- demo_await_args ---")
    tasks {
        task greet(string name, int times) {
            print("hello #s{name} x#i{times}")
            return times
        }
        task {
            int n = await greet("Ada", 3)
            print("returned:")
            print(n)
        }
    }
}
