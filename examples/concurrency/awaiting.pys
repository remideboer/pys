# Named tasks + await, including parameterized tasks.
#
# How return works:
#   return VALUE   inside a named/parameterized task
#   int x = await that_task   (or await that_task(args))
#   → x receives VALUE
# There is no other way to read a task’s return.

global function demo_await_one() {
    print("--- demo_await_one ---")
    tasks {
        # Producer: return value is 41
        task answer {
            return 41
        }
        # Consumer: await plugs that return into n
        task {
            int n = await answer
            int next = n + 1
            print("awaited #i{n}, next=#i{next}")
        }
    }
}

global function demo_await_fan_in() {
    print("--- demo_await_fan_in ---")
    tasks {
        task left(int n) {
            return n
        }
        task right(int n) {
            return n
        }
        task {
            # Each await ...(...) runs that task and yields its return
            int a = await left(10)
            int b = await right(32)
            print("fan-in sum:")
            print(a + b)
        }
    }
}

global function demo_await_chain() {
    print("--- demo_await_chain ---")
    tasks {
        task step1(int n) {
            return n
        }
        task step2(int x) {
            return x * 3
        }
        task {
            # Pipe returns: mid gets step1's return; y gets step2's return
            int mid = await step1(2)
            int y = await step2(mid)
            print("2 * 3 = #i{y}")
        }
    }
}

global function demo_await_args() {
    print("--- demo_await_args ---")
    tasks {
        task greet(string name, int times) {
            print("hello #s{name} x#i{times}")
            return times
        }
        task {
            # greet returns times (3); await binds it to n
            int n = await greet("Ada", 3)
            print("returned:")
            print(n)
        }
    }
}

# Keep a return after the tasks block finishes: copy it while still inside.
global function demo_await_to_outer() {
    print("--- demo_await_to_outer ---")
    shared int kept = 0
    tasks {
        task compute(int x) {
            return x * 10
        }
        task {
            int result = await compute(5)
            kept = result
        }
    }
    print("kept after tasks joined:")
    print(kept)
}
