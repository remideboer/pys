# examples/concurrency — more showcase scenarios (still same folder = package).

global function demo_many_workers() {
    print("--- demo_many_workers ---")
    shared int done = 0
    tasks {
        task {
            print("w1")
            done = done + 1
        }
        task {
            print("w2")
            done = done + 1
        }
        task {
            print("w3")
            done = done + 1
        }
        task {
            print("w4")
            done = done + 1
        }
        task {
            print("w5")
            done = done + 1
        }
    }
    print("workers finished count:")
    print(done)
}

global function demo_await_then_shared() {
    print("--- demo_await_then_shared ---")
    shared int log_count = 0
    tasks {
        task first {
            return 3
        }
        task second {
            return 4
        }
        task {
            int a = await first
            int b = await second
            log_count = log_count + 1
            print("product:")
            print(a * b)
        }
    }
    print("log_count:")
    print(log_count)
}

global function demo_nested_groups_in_sequence() {
    print("--- demo_nested_groups_in_sequence ---")
    shared int phase = 0
    tasks {
        task {
            phase = 1
            print("phase set to 1")
        }
    }
    tasks {
        task {
            print("phase is:")
            print(phase)
            phase = phase + 1
        }
        task {
            print("still phase before join:")
            print(phase)
        }
    }
    print("final phase:")
    print(phase)
}
