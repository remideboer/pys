# More showcase scenarios using parameterized tasks.

global function demo_many_workers() {
    print("--- demo_many_workers ---")
    shared int done = 0
    tasks {
        task work(string id) {
            print(id)
            done = done + 1
        }
        task {
            int a = await work("w1")
            int b = await work("w2")
            int c = await work("w3")
            int d = await work("w4")
            int e = await work("w5")
        }
    }
    print("workers finished count:")
    print(done)
}

global function demo_await_then_shared() {
    print("--- demo_await_then_shared ---")
    shared int log_count = 0
    tasks {
        task first(int n) {
            return n
        }
        task second(int n) {
            return n
        }
        task {
            int a = await first(3)
            int b = await second(4)
            log_count = log_count + 1
            print("product:")
            print(a * b)
        }
    }
    print("log_count:")
    print(log_count)
}

global function demo_nested_groups_in_sequence() {
    print("--- demo_nested_groups_in_sequence ---")
    shared int phase = 0
    tasks {
        task set_phase(int p) {
            phase = p
            print("phase set")
        }
        task {
            int ignored = await set_phase(1)
        }
    }
    tasks {
        task bump() {
            print("phase is:")
            print(phase)
            phase = phase + 1
        }
        task {
            int ignored = await bump()
        }
    }
    print("final phase:")
    print(phase)
}
