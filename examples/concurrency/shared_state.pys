# shared: intentional cross-task mutation (not for ordinary inputs).

global function demo_shared_counter() {
    print("--- demo_shared_counter ---")
    shared int counter = 0
    tasks {
        task bump(int delta) {
            counter = counter + delta
        }
        task {
            int a = await bump(1)
            int b = await bump(1)
            int c = await bump(1)
        }
    }
    print("counter after 3 bumps:")
    print(counter)
}

global function demo_shared_with_params() {
    print("--- demo_shared_with_params ---")
    shared int hits = 0
    tasks {
        task hit(string tag) {
            print("tag=#s{tag}")
            hits = hits + 1
        }
        task {
            int a = await hit("batch")
            int b = await hit("batch")
        }
    }
    print("hits:")
    print(hits)
}

global function demo_shared_accumulate() {
    print("--- demo_shared_accumulate ---")
    shared int total = 0
    tasks {
        task add(int amount) {
            total = total + amount
        }
        task {
            int a = await add(5)
            int b = await add(10)
            int c = await add(15)
        }
    }
    print("total of 5+10+15:")
    print(total)
}
