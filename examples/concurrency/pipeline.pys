# Pipelines and multiple tasks groups — inputs via parameters.

global function demo_two_groups() {
    print("--- demo_two_groups ---")
    tasks {
        task {
            print("group-1 / a")
        }
        task {
            print("group-1 / b")
        }
    }
    print("group 1 done; starting group 2")
    tasks {
        task {
            print("group-2 / c")
        }
        task {
            print("group-2 / d")
        }
    }
    print("group 2 done")
}

global function demo_pipeline_stages() {
    print("--- demo_pipeline_stages ---")
    tasks {
        task part(int n) {
            return n
        }
        task {
            int a = await part(21)
            int b = await part(21)
            print("pipeline combined:")
            print(a + b)
        }
    }
}

global function demo_mixed_await_and_shared() {
    print("--- demo_mixed_await_and_shared ---")
    shared int seen = 0
    tasks {
        task prepared(int value) {
            seen = seen + 1
            return value
        }
        task {
            int value = await prepared(100)
            seen = seen + 1
            print("value:")
            print(value)
        }
    }
    print("seen count:")
    print(seen)
}
