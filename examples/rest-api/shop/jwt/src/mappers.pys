# Data Mapper layer (Fowler): SQL + tuple/entity translation.
# Domain entities and repositories do not know the relational schema.

import sys
import Product, Order, OrderLine from models
import ShopDatabase from db

package interface ProductMapper {
    list<Product> findAll()
    nullable<Product> findById(int id)
    Product insert(string sku, string name, float unitPrice)
    update(Product product)
    delete(Product product)
}

package interface OrderMapper {
    list<Order> findAll()
    nullable<Order> findById(int id)
    Order insert(string status, nullable<string> customerRef)
    update(Order order)
    delete(Order order)
}

package interface OrderLineMapper {
    list<OrderLine> findAll()
    list<OrderLine> findByOrder(int orderId)
    nullable<OrderLine> findById(int orderId, int lineNumber)
    insert(OrderLine line)
    update(OrderLine line)
    delete(OrderLine line)
}

package class MysqlProductMapper implements ProductMapper {
    private ShopDatabase db

    public constructor(ShopDatabase db) {
        this.db = db
    }

    private Product fromRow(tuple row) {
        return Product(
            this.db.cellInt(row[0]),
            this.db.cellStr(row[1]),
            this.db.cellStr(row[2]),
            this.db.cellFloat(row[3]),
            this.db.cellBool(row[4]),
            this.db.cellStr(row[5])
        )
    }

    public list<Product> findAll() {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "SELECT product_id, sku, name, unit_price, active, created_at "
            + "FROM product ORDER BY product_id"
        )
        list<tuple> rows = cur.fetchall()
        cur.close()
        list<Product> products = []
        loop (tuple row in rows) {
            products = products + [this.fromRow(row)]
        }
        return products
    }

    public nullable<Product> findById(int id) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "SELECT product_id, sku, name, unit_price, active, created_at "
            + "FROM product WHERE product_id=%s",
            (id,)
        )
        nullable<tuple> row = cur.fetchone()
        cur.close()
        if (row == null) {
            return null
        }
        return this.fromRow(row)
    }

    public Product insert(string sku, string name, float unitPrice) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "INSERT INTO product (sku, name, unit_price, active) VALUES (%s, %s, %s, 1)",
            (sku, name, unitPrice)
        )
        this.db.commit()
        int id = this.db.cellInt(cur.lastrowid)
        cur.close()
        nullable<Product> inserted = this.findById(id)
        if (inserted == null) {
            sys.exit("Inserted product could not be reloaded.")
        } else {
            return inserted
        }
    }

    public void update(Product product) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "UPDATE product SET sku=%s, name=%s, unit_price=%s, active=%s "
            + "WHERE product_id=%s",
            (product.sku, product.name, product.unitPrice, product.active, product.id())
        )
        this.db.commit()
        cur.close()
    }

    public void delete(Product product) {
        MySQLCursor cur = this.db.cursor()
        cur.execute("DELETE FROM product WHERE product_id=%s", (product.id(),))
        this.db.commit()
        cur.close()
    }
}

package class MysqlOrderMapper implements OrderMapper {
    private ShopDatabase db

    public constructor(ShopDatabase db) {
        this.db = db
    }

    private Order fromRow(tuple row) {
        return Order(
            this.db.cellInt(row[0]),
            this.db.cellStr(row[1]),
            this.db.cellStr(row[2]),
            this.db.cellNullableStr(row[3])
        )
    }

    public list<Order> findAll() {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "SELECT order_id, placed_at, status, customer_ref "
            + "FROM `order` ORDER BY order_id"
        )
        list<tuple> rows = cur.fetchall()
        cur.close()
        list<Order> orders = []
        loop (tuple row in rows) {
            orders = orders + [this.fromRow(row)]
        }
        return orders
    }

    public nullable<Order> findById(int id) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "SELECT order_id, placed_at, status, customer_ref "
            + "FROM `order` WHERE order_id=%s",
            (id,)
        )
        nullable<tuple> row = cur.fetchone()
        cur.close()
        if (row == null) {
            return null
        }
        return this.fromRow(row)
    }

    public Order insert(string status, nullable<string> customerRef) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "INSERT INTO `order` (placed_at, status, customer_ref) "
            + "VALUES (NOW(3), %s, %s)",
            (status, customerRef)
        )
        this.db.commit()
        int id = this.db.cellInt(cur.lastrowid)
        cur.close()
        nullable<Order> inserted = this.findById(id)
        if (inserted == null) {
            sys.exit("Inserted order could not be reloaded.")
        } else {
            return inserted
        }
    }

    public void update(Order order) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "UPDATE `order` SET status=%s, customer_ref=%s "
            + "WHERE order_id=%s",
            (order.status, order.customerRef, order.id())
        )
        this.db.commit()
        cur.close()
    }

    public void delete(Order order) {
        MySQLCursor cur = this.db.cursor()
        cur.execute("DELETE FROM `order` WHERE order_id=%s", (order.id(),))
        this.db.commit()
        cur.close()
    }
}

package class MysqlOrderLineMapper implements OrderLineMapper {
    private ShopDatabase db

    public constructor(ShopDatabase db) {
        this.db = db
    }

    private OrderLine fromRow(tuple row) {
        return OrderLine(
            this.db.cellInt(row[0]),
            this.db.cellStr(row[1]),
            this.db.cellStr(row[2]),
            this.db.cellNullableStr(row[3]),
            this.db.cellInt(row[4]),
            this.db.cellInt(row[5]),
            this.db.cellStr(row[6]),
            this.db.cellFloat(row[7]),
            this.db.cellInt(row[8])
        )
    }

    private list<OrderLine> query(string sql, tuple params) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(sql, params)
        list<tuple> rows = cur.fetchall()
        cur.close()
        list<OrderLine> lines = []
        loop (tuple row in rows) {
            lines = lines + [this.fromRow(row)]
        }
        return lines
    }

    public list<OrderLine> findAll() {
        return this.query(
            "SELECT o.order_id, o.placed_at, o.status, o.customer_ref, "
            + "ol.line_number, ol.product_id, ol.sku_snapshot, ol.unit_price, ol.quantity "
            + "FROM order_line ol "
            + "JOIN `order` o ON o.order_id=ol.order_id "
            + "ORDER BY ol.order_id, ol.line_number",
            ()
        )
    }

    public list<OrderLine> findByOrder(int orderId) {
        return this.query(
            "SELECT o.order_id, o.placed_at, o.status, o.customer_ref, "
            + "ol.line_number, ol.product_id, ol.sku_snapshot, ol.unit_price, ol.quantity "
            + "FROM order_line ol "
            + "JOIN `order` o ON o.order_id=ol.order_id "
            + "WHERE ol.order_id=%s ORDER BY ol.line_number",
            (orderId,)
        )
    }

    public nullable<OrderLine> findById(int orderId, int lineNumber) {
        list<OrderLine> rows = this.query(
            "SELECT o.order_id, o.placed_at, o.status, o.customer_ref, "
            + "ol.line_number, ol.product_id, ol.sku_snapshot, ol.unit_price, ol.quantity "
            + "FROM order_line ol "
            + "JOIN `order` o ON o.order_id=ol.order_id "
            + "WHERE ol.order_id=%s AND ol.line_number=%s",
            (orderId, lineNumber)
        )
        if (len(rows) == 0) {
            return null
        }
        return rows[0]
    }

    public void insert(OrderLine line) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "INSERT INTO order_line "
            + "(order_id, line_number, product_id, sku_snapshot, unit_price, quantity) "
            + "VALUES (%s, %s, %s, %s, %s, %s)",
            (
                line.id(),
                line.lineKey(),
                line.productId,
                line.skuSnapshot,
                line.unitPrice,
                line.quantity
            )
        )
        this.db.commit()
        cur.close()
    }

    public void update(OrderLine line) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "UPDATE order_line SET product_id=%s, sku_snapshot=%s, "
            + "unit_price=%s, quantity=%s "
            + "WHERE order_id=%s AND line_number=%s",
            (
                line.productId,
                line.skuSnapshot,
                line.unitPrice,
                line.quantity,
                line.id(),
                line.lineKey()
            )
        )
        this.db.commit()
        cur.close()
    }

    public void delete(OrderLine line) {
        MySQLCursor cur = this.db.cursor()
        cur.execute(
            "DELETE FROM order_line WHERE order_id=%s AND line_number=%s",
            (line.id(), line.lineKey())
        )
        this.db.commit()
        cur.close()
    }
}
