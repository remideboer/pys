# Dispatch one accepted connection over HTTP/1.1 keep-alive.

import Http11, HttpRequest from http11

package class ConnHandler {
    private Http11 http
    private object router
    private float idleTimeoutSec
    private float writeTimeoutSec

    public constructor(Http11 http, object router, float idleTimeoutSec, float writeTimeoutSec) {
        this.http = http
        this.router = router
        this.idleTimeoutSec = idleTimeoutSec
        this.writeTimeoutSec = writeTimeoutSec
    }

    public void serveOne(conn) {
        conn.settimeout(this.idleTimeoutSec)
        bool open = true
        loop (open) {
            string raw = this.http.readRaw(conn, this.idleTimeoutSec)
            if (raw == "") {
                open = false
            } else {
                HttpRequest req = this.http.parse(raw)
                var resp = this.router.handle(req)
                conn.settimeout(this.writeTimeoutSec)
                this.http.write(conn, resp, req.keepAlive)
                conn.settimeout(this.idleTimeoutSec)
                if (!req.keepAlive) {
                    open = false
                }
            }
        }
        conn.close()
    }
}
