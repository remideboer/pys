# Infrastructure: MySQL session + row cell helpers (SRP: connection only).

import sys
import mysql.connector

package class ShopDatabase {
    private MySQLConnection conn

    public ShopDatabase(string host, string user, string password, string database) {
        this.conn = mysql.connector.connect(
            host=host,
            user=user,
            password=password,
            database=database
        )
    }

    public MySQLCursor cursor() {
        return this.conn.cursor()
    }

    public void commit() {
        this.conn.commit()
    }

    public void close() {
        this.conn.close()
    }

    public nullable<string> cellNullableStr(var value) {
        if (value == null) {
            return null
        }
        string s = str(value)
        return s
    }

    public string cellStr(var value) {
        if (value == null) {
            # NOT NULL column returned SQL NULL — never invent "" / 0.
            sys.exit("Database contract violation: expected a non-null string cell.")
        }
        string s = str(value)
        return s
    }

    public bool cellBool(var value) {
        bool flag = int(this.cellStr(value)) == 1
        return flag
    }

    public float cellFloat(var value) {
        float n = float(this.cellStr(value))
        return n
    }

    public int cellInt(var value) {
        int n = int(this.cellStr(value))
        return n
    }
}
