# TCP e2e: health + list products against in-process server.

import socket
import select
import time

import ConnQueue from conn_queue
import Http11 from http11
import ConnHandler from conn_handler
import AppContext, Router from router

AppContext ctx = AppContext()
Router router = Router(ctx)
Http11 http = Http11()
ConnHandler handler = ConnHandler(http, router, 0.5, 0.5)

shared ConnQueue work = ConnQueue()
shared bool running = true
shared int listenPort = 0
shared ConnHandler sharedHandler = handler
atomic int served = 0
shared string clientResult = ""

tasks {
    task acceptor {
        var srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        var bindAddr = ["127.0.0.1", 0]
        srv.bind(tuple(bindAddr))
        srv.listen(16)
        srv.setblocking(false)
        listenPort = srv.getsockname()[1]
        var empty = []
        int left = 2
        loop (running && left > 0) {
            var readers = [srv]
            var ready = select.select(readers, empty, empty, 0.05)
            if (len(ready[0]) > 0) {
                var pair = srv.accept()
                var client = pair[0]
                client.setblocking(true)
                work.putConn(client)
                left = left - 1
            }
        }
        work.putPoison()
        running = false
        srv.close()
    }

    task worker {
        bool done = false
        loop (!done) {
            var conn = work.takeConn()
            if (conn == null) {
                done = true
            } else {
                sharedHandler.serveOne(conn)
                served += 1
            }
        }
    }

    task client {
        loop (listenPort == 0) {
            time.sleep(0.01)
        }
        int port = listenPort
        var addr = ["127.0.0.1", port]

        var s1 = socket.create_connection(tuple(addr), 2.0)
        string req1 = "GET /health HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
        s1.sendall(req1.encode("utf-8"))
        string data1 = s1.recv(4096).decode("utf-8")
        s1.close()

        var s2 = socket.create_connection(tuple(addr), 2.0)
        string req2 = "GET /api/products HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
        s2.sendall(req2.encode("utf-8"))
        string data2 = s2.recv(8192).decode("utf-8")
        s2.close()

        bool allGood = false
        if (data1.find("200 OK") >= 0) {
            if (data1.find("ok") >= 0) {
                if (data2.find("200 OK") >= 0) {
                    if (data2.find("Catan") >= 0) {
                        if (data2.find("application/json") >= 0) {
                            allGood = true
                        }
                    }
                }
            }
        }
        if (allGood) {
            clientResult = "PASS"
        } else {
            clientResult = "FAIL"
            print(data1)
            print(data2)
        }
        time.sleep(0.05)
        running = false
    }
}

if (clientResult == "PASS") {
    print("PASS e2e health and products over TCP")
} else {
    print("FAIL e2e health and products over TCP")
}
if (served.get() >= 2) {
    print("PASS e2e served count")
} else {
    print("FAIL e2e served count")
}
print("=== http e2e done ===")
