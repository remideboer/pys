# Shared work queue for acceptor → workers.

import queue

package class ConnQueue {
    private object q

    public constructor() {
        this.q = queue.Queue()
    }

    public void putConn(conn) {
        this.q.put(conn)
    }

    public object takeConn() {
        return this.q.get()
    }

    public void putPoison() {
        this.q.put(null)
    }
}
