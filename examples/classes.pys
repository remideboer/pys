# Classes in general: fields, constructors, visibility, inherits, open/override, closed.
# For interfaces see examples/interfaces.pys; for abstract classes see
# examples/abstract_classes.pys; for traits see examples/traits.pys.

# --- Basic class: fields, constructor, this, public method ---
class Person {
    private string name

    public constructor(string name) {
        this.name = name
    }

    public string label() {
        return "Person:" + this.name
    }

    public string getName() {
        return this.name
    }
}

Person ada = Person("Ada")
print(ada.label())  # Person:Ada
print(ada.getName())  # Ada

# --- Constructor with parameters (fields via this) ---
# For this(...) ctor chaining across overloads, see Vehicle in interfaces.pys.
class Point {
    private int x
    private int y

    public constructor(int x, int y) {
        this.x = x
        this.y = y
    }

    public string show() {
        return "(" + this.x + "," + this.y + ")"
    }
}

Point origin = Point(0, 0)
Point p = Point(3, 4)
print(origin.show())  # (0,0)
print(p.show())  # (3,4)

# --- Inheritance: protected field + super() + override ---
class Animal {
    protected string kind

    public constructor(string kind) {
        this.kind = kind
    }

    public open string speak() {
        return this.kind + " makes a sound"
    }
}

class Dog inherits Animal {
    private string name

    public constructor(string name) {
        super("dog")
        this.name = name
    }

    public override string speak() {
        return this.name + " the " + this.kind + " says woof"
    }
}

Dog rex = Dog("Rex")
print(rex.speak())  # Rex the dog says woof

# Polymorphic binding: static type is the parent class.
Animal a = rex
print(a.speak())  # Rex the dog says woof

# --- Closed class: usable, but no further inherits ---
closed class Unit {
    private string id

    public constructor(string id) {
        this.id = id
    }

    public string tag() {
        return "unit#" + this.id
    }
}

Unit u = Unit("42")
print(u.tag())  # unit#42

# --- Root override: toString + this(...) / super(...) ctor chaining ---
class Vehicle {
    protected fix string plate

    public constructor(string plate) {
        this.plate = plate
    }

    public override string toString() {
        return "Vehicle plate=" + this.plate
    }
}

class Car inherits Vehicle {
    private fix string model

    public constructor() {
        this("UNKNOWN", "Unnamed")
    }

    public constructor(string plate, string model) {
        super(plate)
        this.model = model
    }

    public override closed string toString() {
        return "Car plate=" + this.plate + " model=" + this.model
    }
}

Car defaultCar = Car()
print(defaultCar.toString())  # Car plate=UNKNOWN model=Unnamed
Car named = Car("ABC-1", "Roadster")
print(named.toString())  # Car plate=ABC-1 model=Roadster
