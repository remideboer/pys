# Login + bearer extraction (teaching users — not a real identity store).

import ApiResponse from api_response
import JsonUtil from json_util
import JwtService from jwt_service

package class AuthService {
    private JwtService jwt
    private JsonUtil json
    private dict passwords

    public constructor(JwtService jwt, JsonUtil json) {
        this.jwt = jwt
        this.json = json
        dict pw = dict()
        pw["admin"] = "admin123"
        pw["clerk"] = "clerk123"
        this.passwords = pw
    }

    public ApiResponse login(object body) {
        nullable<dict> rawBody = this.json.asObject(body)
        if (rawBody == null) {
            return ApiResponse(400, this.json.errorBody("JSON object required"))
        }
        dict b = rawBody
        if (!("username" in b) || !("password" in b)) {
            return ApiResponse(400, this.json.errorBody("username and password required"))
        }
        string user = str(b["username"])
        string password = str(b["password"])
        dict pw = this.passwords
        if (!(user in pw) || pw[user] != password) {
            return ApiResponse(401, this.json.errorBody("invalid credentials"))
        }
        string token = this.jwt.issue(user)
        dict out = dict()
        out["accessToken"] = token
        out["tokenType"] = "Bearer"
        out["username"] = user
        return ApiResponse(200, out)
    }

    public nullable<string> requireUser(object req) {
        object headers = req.headers
        var authHeader = headers.authorization
        if (authHeader == null) {
            authHeader = headers.Authorization
        }
        if (authHeader == null) {
            return null
        }
        string header = str(authHeader)
        if (header == "") {
            return null
        }
        string lower = header.lower()
        if (!lower.startswith("bearer ")) {
            return null
        }
        string token = header[7:].strip()
        return this.jwt.subjectOf(token)
    }

    public ApiResponse unauthorized() {
        return ApiResponse(401, this.json.errorBody("bearer token required"))
    }
}
