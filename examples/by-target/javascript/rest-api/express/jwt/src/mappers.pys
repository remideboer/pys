# Data Mapper layer: SQL + row→entity (mysql2 callback queries).

import Product, Order, OrderLine from models
import ShopDatabase from db

package interface ProductMapper {
    void findAll(object onDone)
    void findById(int id, object onDone)
    void insert(string sku, string name, float unitPrice, object onDone)
    void update(Product product, object onDone)
    void delete(Product product, object onDone)
}

package interface OrderMapper {
    void findAll(object onDone)
    void findById(int id, object onDone)
    void insert(string status, nullable<string> customerRef, object onDone)
    void update(Order order, object onDone)
    void delete(Order order, object onDone)
}

package interface OrderLineMapper {
    void findAll(object onDone)
    void findByOrder(int orderId, object onDone)
    void findById(int orderId, int lineNumber, object onDone)
    void insert(OrderLine line, object onDone)
    void update(OrderLine line, object onDone)
    void delete(OrderLine line, object onDone)
}

package class MysqlProductMapper implements ProductMapper {
    private ShopDatabase db

    public constructor(ShopDatabase db) {
        this.db = db
    }

    private Product fromRow(object row) {
        return Product(
            this.db.cellInt(row[0]),
            this.db.cellStr(row[1]),
            this.db.cellStr(row[2]),
            this.db.cellFloat(row[3]),
            this.db.cellBool(row[4]),
            this.db.cellStr(row[5])
        )
    }

    public void findAll(object onDone) {
        ShopDatabase db = this.db
        MysqlProductMapper mapper = this
        db.query(
            "SELECT product_id, sku, name, unit_price, active, created_at FROM product ORDER BY product_id",
            [],
            (object err, object rows) => {
                if (err != null) {
                    onDone(err, null)
                    return
                }
                list<Product> products = []
                loop (object row in rows) {
                    products.append(mapper.fromRow(row))
                }
                onDone(null, products)
            }
        )
    }

    public void findById(int id, object onDone) {
        ShopDatabase db = this.db
        MysqlProductMapper mapper = this
        db.query(
            "SELECT product_id, sku, name, unit_price, active, created_at FROM product WHERE product_id=?",
            [id],
            (object err, object rows) => {
                if (err != null) {
                    onDone(err, null)
                    return
                }
                if (len(rows) == 0) {
                    onDone(null, null)
                    return
                }
                onDone(null, mapper.fromRow(rows[0]))
            }
        )
    }

    public void insert(string sku, string name, float unitPrice, object onDone) {
        ShopDatabase db = this.db
        MysqlProductMapper mapper = this
        db.query(
            "INSERT INTO product (sku, name, unit_price, active) VALUES (?, ?, ?, 1)",
            [sku, name, unitPrice],
            (object err, object result) => {
                if (err != null) {
                    onDone(err, null)
                    return
                }
                int newId = (int)(result.insertId)
                mapper.findById(newId, onDone)
            }
        )
    }

    public void update(Product product, object onDone) {
        int activeFlag = 0
        if (product.active) {
            activeFlag = 1
        }
        this.db.query(
            "UPDATE product SET sku=?, name=?, unit_price=?, active=? WHERE product_id=?",
            [product.sku, product.name, product.unitPrice, activeFlag, product.id()],
            (object err, object result) => {
                onDone(err, null)
            }
        )
    }

    public void delete(Product product, object onDone) {
        this.db.query(
            "DELETE FROM product WHERE product_id=?",
            [product.id()],
            (object err, object result) => {
                onDone(err, null)
            }
        )
    }
}

package class MysqlOrderMapper implements OrderMapper {
    private ShopDatabase db

    public constructor(ShopDatabase db) {
        this.db = db
    }

    private Order fromRow(object row) {
        return Order(
            this.db.cellInt(row[0]),
            this.db.cellStr(row[1]),
            this.db.cellStr(row[2]),
            this.db.cellNullableStr(row[3])
        )
    }

    public void findAll(object onDone) {
        ShopDatabase db = this.db
        MysqlOrderMapper mapper = this
        db.query(
            "SELECT order_id, placed_at, status, customer_ref FROM `order` ORDER BY order_id",
            [],
            (object err, object rows) => {
                if (err != null) {
                    onDone(err, null)
                    return
                }
                list<Order> orders = []
                loop (object row in rows) {
                    orders.append(mapper.fromRow(row))
                }
                onDone(null, orders)
            }
        )
    }

    public void findById(int id, object onDone) {
        ShopDatabase db = this.db
        MysqlOrderMapper mapper = this
        db.query(
            "SELECT order_id, placed_at, status, customer_ref FROM `order` WHERE order_id=?",
            [id],
            (object err, object rows) => {
                if (err != null) {
                    onDone(err, null)
                    return
                }
                if (len(rows) == 0) {
                    onDone(null, null)
                    return
                }
                onDone(null, mapper.fromRow(rows[0]))
            }
        )
    }

    public void insert(string status, nullable<string> customerRef, object onDone) {
        ShopDatabase db = this.db
        MysqlOrderMapper mapper = this
        db.query(
            "INSERT INTO `order` (status, customer_ref) VALUES (?, ?)",
            [status, customerRef],
            (object err, object result) => {
                if (err != null) {
                    onDone(err, null)
                    return
                }
                mapper.findById((int)(result.insertId), onDone)
            }
        )
    }

    public void update(Order order, object onDone) {
        this.db.query(
            "UPDATE `order` SET status=?, customer_ref=? WHERE order_id=?",
            [order.status, order.customerRef, order.id()],
            (object err, object result) => {
                onDone(err, null)
            }
        )
    }

    public void delete(Order order, object onDone) {
        this.db.query(
            "DELETE FROM `order` WHERE order_id=?",
            [order.id()],
            (object err, object result) => {
                onDone(err, null)
            }
        )
    }
}

package class MysqlOrderLineMapper implements OrderLineMapper {
    private ShopDatabase db

    public constructor(ShopDatabase db) {
        this.db = db
    }

    private OrderLine fromRow(object row) {
        return OrderLine(
            this.db.cellInt(row[0]),
            this.db.cellStr(row[1]),
            this.db.cellStr(row[2]),
            this.db.cellNullableStr(row[3]),
            this.db.cellInt(row[4]),
            this.db.cellInt(row[5]),
            this.db.cellStr(row[6]),
            this.db.cellFloat(row[7]),
            this.db.cellInt(row[8])
        )
    }

    public void findAll(object onDone) {
        ShopDatabase db = this.db
        MysqlOrderLineMapper mapper = this
        db.query(
            "SELECT o.order_id, o.placed_at, o.status, o.customer_ref, "
            + "l.line_number, l.product_id, l.sku_snapshot, l.unit_price, l.quantity "
            + "FROM order_line l JOIN `order` o ON o.order_id = l.order_id "
            + "ORDER BY l.order_id, l.line_number",
            [],
            (object err, object rows) => {
                if (err != null) {
                    onDone(err, null)
                    return
                }
                list<OrderLine> lines = []
                loop (object row in rows) {
                    lines.append(mapper.fromRow(row))
                }
                onDone(null, lines)
            }
        )
    }

    public void findByOrder(int orderId, object onDone) {
        ShopDatabase db = this.db
        MysqlOrderLineMapper mapper = this
        db.query(
            "SELECT o.order_id, o.placed_at, o.status, o.customer_ref, "
            + "l.line_number, l.product_id, l.sku_snapshot, l.unit_price, l.quantity "
            + "FROM order_line l JOIN `order` o ON o.order_id = l.order_id "
            + "WHERE l.order_id=? ORDER BY l.line_number",
            [orderId],
            (object err, object rows) => {
                if (err != null) {
                    onDone(err, null)
                    return
                }
                list<OrderLine> lines = []
                loop (object row in rows) {
                    lines.append(mapper.fromRow(row))
                }
                onDone(null, lines)
            }
        )
    }

    public void findById(int orderId, int lineNumber, object onDone) {
        ShopDatabase db = this.db
        MysqlOrderLineMapper mapper = this
        db.query(
            "SELECT o.order_id, o.placed_at, o.status, o.customer_ref, "
            + "l.line_number, l.product_id, l.sku_snapshot, l.unit_price, l.quantity "
            + "FROM order_line l JOIN `order` o ON o.order_id = l.order_id "
            + "WHERE l.order_id=? AND l.line_number=?",
            [orderId, lineNumber],
            (object err, object rows) => {
                if (err != null) {
                    onDone(err, null)
                    return
                }
                if (len(rows) == 0) {
                    onDone(null, null)
                    return
                }
                onDone(null, mapper.fromRow(rows[0]))
            }
        )
    }

    public void insert(OrderLine line, object onDone) {
        this.db.query(
            "INSERT INTO order_line (order_id, line_number, product_id, sku_snapshot, unit_price, quantity) "
            + "VALUES (?, ?, ?, ?, ?, ?)",
            [line.id(), line.lineKey(), line.productId, line.skuSnapshot, line.unitPrice, line.quantity],
            (object err, object result) => {
                onDone(err, null)
            }
        )
    }

    public void update(OrderLine line, object onDone) {
        this.db.query(
            "UPDATE order_line SET quantity=? WHERE order_id=? AND line_number=?",
            [line.quantity, line.id(), line.lineKey()],
            (object err, object result) => {
                onDone(err, null)
            }
        )
    }

    public void delete(OrderLine line, object onDone) {
        this.db.query(
            "DELETE FROM order_line WHERE order_id=? AND line_number=?",
            [line.id(), line.lineKey()],
            (object err, object result) => {
                onDone(err, null)
            }
        )
    }
}
