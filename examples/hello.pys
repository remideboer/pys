interface Startable {
    public start()
}

class Car implements Startable {
    protected string make
    protected string model
    protected int year

    public Car(string make, string model) {
        this(make, model, 1976)
    }

    public Car(string make, string model, int year) {
        this.make = make
        this.model = model
        this.year = year
    }

    public drive() {
        print("Car started: {this.make} {this.model} {this.year} driving")
    }

    public drive(string name) {
        print("Car {name} started: {this.make} {this.model} {this.year} driving")
    }

    public start() {
        print("Car started: {this.make} {this.model} {this.year} starting")
    }
}

class Truck inherits Car {
    private int loadCapacity

    public Truck(string make, string model, int year, int loadCapacity) {
        super(make, model, year)
        this.loadCapacity = loadCapacity
    }

    public drive() {
        print("Truck started: {this.make} {this.model} {this.year} with load capacity {this.loadCapacity} driving")
    }

    public haul(int weight) {
        print("Truck hauling {weight} pounds")
    }
}

Car car = Car("Toyota", "Corolla", 2020)
car.drive()
car.drive("DODODODOD")

car = Car("Toyota", "Corolla")
car.drive()
car.drive("DODODODOD")

Truck truck = Truck("Ford", "F-150", 2020, 1000)
truck.drive()

# Polymorphism: declared type vs actual type
Startable starter = car
starter.start()

Car vehicle = truck
vehicle.drive()

Truck truck2 = truck
truck2.haul(1000)


print("#o{car} is an object")
print(car)

class Container<T, U> {
    private T[] items
    private U item

    public Container() {
        this([], U())
    }

    public Container(T[] items) {
        this(items, U())
    }

    public Container(T[] items, U item) {
        this.items = items
        this.item = item
    }

    public add(T item) {
        this.items.append(item)
    }

    public T get(int index) {
        return this.items[index]
    }

    public U get_the_item() {
        return this.item
    }
}

class Box<T> {
    private T[] items

    public Box() {
        this.items = []
    }

    public add(T item) {
        this.items.append(item)
    }

    public T get(int index) {
        return this.items[index]
    }
}

Container<Car, Truck> container = Container<Car, Truck>()
container.add(car)
container.add(truck)
print(container.get(0).drive())
print(container.get_the_item().drive())

Box<Truck> box = Box<Truck>()
box.add(truck)
print(box.get(0).drive())

Box<int> box = Box<int>()
box.add(5)
print(box.get(0))

print(box)