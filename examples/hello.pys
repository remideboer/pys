# typed string interpolation (type guards, not casts)
string greeting = "hello"
char letter = 'A'
bool flag = true
print("#s{greeting} is a string")
print("#i{x} is an int")
print("#f{f} is a float")
print("#c{letter} is a char")
print("#b{flag} is a bool")
print("the \# symbol is used for typed interpolation")


