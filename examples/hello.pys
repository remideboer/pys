int x = 10;
int y = 20;

function greet(name){
    print ("Hello, ");
}

if (x < y) {
    greet("student");
}
else {
    print("x is greater or equal to y");
}

loop (int i = 0; i < 5; i++) {
    print(i);
}

class Car {
    private string make;
    private string model;
    private int year;

    public Car(string make, string model, int year) {
        this.make = make;
        this.model = model;
        this.year = year;
    }

    function drive() {
        print("Car started: {this.make} {this.model} {this.year} driving");
    }
}

Car car = Car();

car.make = "Toyota";

car.drive();