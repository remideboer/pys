# ui.pys — Tkinter notebook: Catalog | Collection | Decks (master–detail)

import tkinter as tk
import tkinter.ttk as ttk
import tkinter.messagebox as messagebox
import store
import domain

package class PokemonApp {
    private AppStore appStore
    private list uiRoot
    private list catalogList
    private list catalogDetail
    private list catalogIds
    private list collectionList
    private list collectionDetail
    private list typeStatsBox
    private list collectionIds
    private list deckList
    private list deckCards
    private list deckDetail
    private list deckNames
    private list newDeckEntry

    public refreshCatalog() {
        this.catalogList[0].delete(0, "end")
        this.catalogIds = []
        loop (Card c in this.appStore.getCatalog().allCards()) {
            this.catalogList[0].insert("end", c.listLabel())
            this.catalogIds.append(c.getId())
        }
    }

    public refreshCollection() {
        this.collectionList[0].delete(0, "end")
        this.collectionIds = []
        loop (OwnedEntry e in this.appStore.getCollection().getOwned()) {
            Card c = this.appStore.getCatalog().get(e.getCardId())
            int q = e.getQuantity()
            string label = e.getCardId() + " x" + str(q)
            if (c != null) {
                label = c.getName() + " x" + str(q)
            }
            this.collectionList[0].insert("end", label)
            this.collectionIds.append(e.getCardId())
        }
        this.typeStatsBox[0].delete("1.0", "end")
        list<TypeStat> typeStats = this.appStore.getCollection().statsByType(this.appStore.getCatalog())
        if (len(typeStats) == 0) {
            this.typeStatsBox[0].insert("1.0", "No owned cards yet.")
        }
        else {
            string text = "Stats by type:\n"
            loop (TypeStat st in typeStats) {
                text = text + st.summary() + "\n"
            }
            this.typeStatsBox[0].insert("1.0", text)
        }
    }

    public refreshDecks() {
        this.deckList[0].delete(0, "end")
        this.deckNames = []
        loop (Deck d in this.appStore.getDecks().getDecks()) {
            int n = d.totalCards()
            string label = d.getName() + " (" + str(n) + " cards)"
            this.deckList[0].insert("end", label)
            this.deckNames.append(d.getName())
        }
    }

    public showCatalogDetail() {
        list sel = this.catalogList[0].curselection()
        if (len(sel) == 0) {
            return
        }
        int idx = sel[0]
        string cid = this.catalogIds[idx]
        Card c = this.appStore.getCatalog().get(cid)
        this.catalogDetail[0].delete("1.0", "end")
        if (c != null) {
            this.catalogDetail[0].insert("1.0", c.detailText())
        }
    }

    public addSelectedToCollection() {
        list sel = this.catalogList[0].curselection()
        if (len(sel) == 0) {
            messagebox.showinfo("Collection", "Select a card in the catalog first.")
            return
        }
        int idx = sel[0]
        string cid = this.catalogIds[idx]
        this.appStore.getCollection().addCard(cid, 1)
        this.appStore.saveCollection()
        this.refreshCollection()
        messagebox.showinfo("Collection", "Added 1 copy to your collection.")
    }

    public showCollectionDetail() {
        list sel = this.collectionList[0].curselection()
        if (len(sel) == 0) {
            return
        }
        int idx = sel[0]
        string cid = this.collectionIds[idx]
        Card c = this.appStore.getCatalog().get(cid)
        int qty = this.appStore.getCollection().quantityOf(cid)
        this.collectionDetail[0].delete("1.0", "end")
        string header = "Owned quantity: " + str(qty) + "\n\n"
        if (c != null) {
            this.collectionDetail[0].insert("1.0", header + c.detailText())
        }
        else {
            this.collectionDetail[0].insert("1.0", header + "Unknown card id: " + cid)
        }
    }

    public bumpOwned(int delta) {
        list sel = this.collectionList[0].curselection()
        if (len(sel) == 0) {
            messagebox.showinfo("Collection", "Select an owned card first.")
            return
        }
        int idx = sel[0]
        string cid = this.collectionIds[idx]
        this.appStore.getCollection().addCard(cid, delta)
        this.appStore.saveCollection()
        this.refreshCollection()
        this.refreshDecks()
    }

    public onBumpPlus() {
        this.bumpOwned(1)
    }

    public onBumpMinus() {
        this.bumpOwned(-1)
    }

    public removeOwned() {
        list sel = this.collectionList[0].curselection()
        if (len(sel) == 0) {
            return
        }
        int idx = sel[0]
        string cid = this.collectionIds[idx]
        this.appStore.getCollection().removeCard(cid)
        this.appStore.saveCollection()
        this.refreshCollection()
        this.refreshDecks()
    }

    public showDeckDetail() {
        list sel = this.deckList[0].curselection()
        this.deckCards[0].delete(0, "end")
        this.deckDetail[0].delete("1.0", "end")
        if (len(sel) == 0) {
            return
        }
        int idx = sel[0]
        string name = this.deckNames[idx]
        Deck d = this.appStore.getDecks().getByName(name)
        if (d == null) {
            return
        }
        int total = d.totalCards()
        string text = "Deck: " + name + "\nTotal cards: " + str(total) + "\n"
        this.deckDetail[0].insert("1.0", text)
        loop (OwnedEntry e in d.getEntries()) {
            Card c = this.appStore.getCatalog().get(e.getCardId())
            int q = e.getQuantity()
            string label = e.getCardId() + " x" + str(q)
            if (c != null) {
                label = c.getName() + " x" + str(q)
            }
            this.deckCards[0].insert("end", label)
        }
    }

    public createDeck() {
        string name = this.newDeckEntry[0].get().strip()
        if (name == "") {
            messagebox.showinfo("Decks", "Enter a deck name.")
            return
        }
        bool ok = this.appStore.getDecks().createDeck(name)
        if (ok == false) {
            messagebox.showerror("Decks", "A deck with that name already exists.")
            return
        }
        this.appStore.saveDecks()
        this.newDeckEntry[0].delete(0, "end")
        this.refreshDecks()
    }

    public deleteSelectedDeck() {
        list sel = this.deckList[0].curselection()
        if (len(sel) == 0) {
            return
        }
        int idx = sel[0]
        string name = this.deckNames[idx]
        this.appStore.getDecks().deleteDeck(name)
        this.appStore.saveDecks()
        this.refreshDecks()
        this.deckCards[0].delete(0, "end")
        this.deckDetail[0].delete("1.0", "end")
    }

    public addOwnedToDeck() {
        list dsel = this.deckList[0].curselection()
        if (len(dsel) == 0) {
            messagebox.showinfo("Decks", "Select a deck first.")
            return
        }
        string cardId = ""
        list csel = this.collectionList[0].curselection()
        if (len(csel) > 0) {
            cardId = this.collectionIds[csel[0]]
        }
        else {
            list catsel = this.catalogList[0].curselection()
            if (len(catsel) == 0) {
                messagebox.showinfo("Decks", "Select a card in Collection (or Catalog).")
                return
            }
            cardId = this.catalogIds[catsel[0]]
        }
        int owned = this.appStore.getCollection().quantityOf(cardId)
        if (owned <= 0) {
            messagebox.showerror("Decks", "You can only add cards you own. Add it to your collection first.")
            return
        }
        string name = this.deckNames[dsel[0]]
        Deck d = this.appStore.getDecks().getByName(name)
        int current = 0
        if (d != null) {
            current = d.quantityOf(cardId)
        }
        int nextQty = current + 1
        bool ok = this.appStore.getDecks().setDeckCard(name, cardId, nextQty, this.appStore.getCollection())
        if (ok == false) {
            messagebox.showerror("Decks", "Not enough owned copies for this deck.")
            return
        }
        this.appStore.saveDecks()
        this.refreshDecks()
        this.deckList[0].selection_set(dsel[0])
        this.showDeckDetail()
    }

    public removeCardFromDeck() {
        list dsel = this.deckList[0].curselection()
        list csel = this.deckCards[0].curselection()
        if (len(dsel) == 0) {
            return
        }
        if (len(csel) == 0) {
            return
        }
        string name = this.deckNames[dsel[0]]
        Deck d = this.appStore.getDecks().getByName(name)
        if (d == null) {
            return
        }
        list entries = d.getEntries()
        int idx = csel[0]
        if (idx >= len(entries)) {
            return
        }
        OwnedEntry e = entries[idx]
        int nextQty = e.getQuantity() - 1
        this.appStore.getDecks().setDeckCard(name, e.getCardId(), nextQty, this.appStore.getCollection())
        this.appStore.saveDecks()
        this.refreshDecks()
        this.deckList[0].selection_set(dsel[0])
        this.showDeckDetail()
    }

    public run() {
        this.uiRoot[0].mainloop()
    }

    public PokemonApp(AppStore appStore) {
        this.appStore = appStore
        this.catalogIds = []
        this.collectionIds = []
        this.deckNames = []
        this.uiRoot = []
        this.catalogList = []
        this.catalogDetail = []
        this.collectionList = []
        this.collectionDetail = []
        this.typeStatsBox = []
        this.deckList = []
        this.deckCards = []
        this.deckDetail = []
        this.newDeckEntry = []

        this.uiRoot.append(tk.Tk())
        this.uiRoot[0].title("PYS Pokemon TCG Demo")
        this.uiRoot[0].geometry("900x560")

        this.uiRoot.append(ttk.Notebook(this.uiRoot[0]))
        this.uiRoot[1].pack(fill="both", expand=True, padx=8, pady=8)

        this.uiRoot.append(ttk.Frame(this.uiRoot[1]))
        this.uiRoot[1].add(this.uiRoot[2], text="Catalog")
        this.uiRoot.append(ttk.Frame(this.uiRoot[2]))
        this.uiRoot[3].pack(side="left", fill="both", expand=True)
        this.uiRoot.append(ttk.Frame(this.uiRoot[2]))
        this.uiRoot[4].pack(side="right", fill="both", expand=True)
        ttk.Label(this.uiRoot[3], text="Cards (TCGdex extract)").pack(anchor="w")
        this.catalogList.append(tk.Listbox(this.uiRoot[3], width=40))
        this.catalogList[0].pack(fill="both", expand=True)
        ttk.Button(this.uiRoot[3], text="Show detail", command=this.showCatalogDetail).pack(fill="x", pady=2)
        ttk.Button(this.uiRoot[3], text="Add to collection", command=this.addSelectedToCollection).pack(fill="x", pady=2)
        this.catalogDetail.append(tk.Text(this.uiRoot[4], width=50, height=30))
        this.catalogDetail[0].pack(fill="both", expand=True)

        this.uiRoot.append(ttk.Frame(this.uiRoot[1]))
        this.uiRoot[1].add(this.uiRoot[5], text="Collection")
        this.uiRoot.append(ttk.Frame(this.uiRoot[5]))
        this.uiRoot[6].pack(side="left", fill="both", expand=True)
        this.uiRoot.append(ttk.Frame(this.uiRoot[5]))
        this.uiRoot[7].pack(side="right", fill="both", expand=True)
        ttk.Label(this.uiRoot[6], text="Owned cards").pack(anchor="w")
        this.collectionList.append(tk.Listbox(this.uiRoot[6], width=40))
        this.collectionList[0].pack(fill="both", expand=True)
        ttk.Button(this.uiRoot[6], text="Show detail", command=this.showCollectionDetail).pack(fill="x", pady=2)
        this.uiRoot.append(ttk.Frame(this.uiRoot[6]))
        this.uiRoot[8].pack(fill="x")
        ttk.Button(this.uiRoot[8], text="+1", command=this.onBumpPlus).pack(side="left", expand=True, fill="x")
        ttk.Button(this.uiRoot[8], text="-1", command=this.onBumpMinus).pack(side="left", expand=True, fill="x")
        ttk.Button(this.uiRoot[8], text="Remove", command=this.removeOwned).pack(side="left", expand=True, fill="x")
        this.collectionDetail.append(tk.Text(this.uiRoot[7], width=50, height=18))
        this.collectionDetail[0].pack(fill="both", expand=True)
        ttk.Label(this.uiRoot[7], text="Stats by type").pack(anchor="w")
        this.typeStatsBox.append(tk.Text(this.uiRoot[7], width=50, height=8))
        this.typeStatsBox[0].pack(fill="both", expand=True)

        this.uiRoot.append(ttk.Frame(this.uiRoot[1]))
        this.uiRoot[1].add(this.uiRoot[9], text="Decks")
        this.uiRoot.append(ttk.Frame(this.uiRoot[9]))
        this.uiRoot[10].pack(side="left", fill="both", expand=True)
        this.uiRoot.append(ttk.Frame(this.uiRoot[9]))
        this.uiRoot[11].pack(side="right", fill="both", expand=True)
        ttk.Label(this.uiRoot[10], text="Your decks").pack(anchor="w")
        this.deckList.append(tk.Listbox(this.uiRoot[10], width=40))
        this.deckList[0].pack(fill="both", expand=True)
        ttk.Button(this.uiRoot[10], text="Show detail", command=this.showDeckDetail).pack(fill="x", pady=2)
        this.uiRoot.append(ttk.Frame(this.uiRoot[10]))
        this.uiRoot[12].pack(fill="x", pady=4)
        this.newDeckEntry.append(ttk.Entry(this.uiRoot[12]))
        this.newDeckEntry[0].pack(side="left", fill="x", expand=True)
        ttk.Button(this.uiRoot[12], text="Create", command=this.createDeck).pack(side="left")
        ttk.Button(this.uiRoot[10], text="Delete deck", command=this.deleteSelectedDeck).pack(fill="x")
        ttk.Button(this.uiRoot[10], text="Add selected owned/catalog card", command=this.addOwnedToDeck).pack(fill="x")
        ttk.Button(this.uiRoot[10], text="Remove selected deck card", command=this.removeCardFromDeck).pack(fill="x")
        this.deckDetail.append(tk.Text(this.uiRoot[11], width=50, height=8))
        this.deckDetail[0].pack(fill="x")
        ttk.Label(this.uiRoot[11], text="Cards in deck").pack(anchor="w")
        this.deckCards.append(tk.Listbox(this.uiRoot[11], width=50))
        this.deckCards[0].pack(fill="both", expand=True)

        this.refreshCatalog()
        this.refreshCollection()
        this.refreshDecks()
    }
}
