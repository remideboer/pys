# examples/webserver/test_http_keepalive_e2e.pys
# Given HTTP/1.1 keep-alive,
# When a client sends two GET /health requests on one TCP connection,
# Then both return 200 and Connection: keep-alive (FR2).

import socket
import select
import time

import ServerConfig from config
import ConnQueue from conn_queue
import Http11 from http11
import Http2Server from http2
import ConnHandler from conn_handler
import AppContext, Router from router

ServerConfig cfg = ServerConfig()
cfg.poolSize = 4
AppContext ctx = AppContext(cfg)
Router router = Router(ctx)
Http11 http = Http11()
Http2Server http2 = Http2Server()
ConnHandler handler = ConnHandler(http, http2, router, 1.0)

shared ConnQueue work = ConnQueue()
shared bool running = true
shared int listenPort = 0
shared ConnHandler sharedHandler = handler
atomic int served = 0
shared int okResponses = 0

tasks {
    task acceptor {
        var srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        var bindAddr = ["127.0.0.1", 0]
        srv.bind(tuple(bindAddr))
        srv.listen(16)
        srv.setblocking(false)
        listenPort = srv.getsockname()[1]
        var empty = []
        int left = 1
        loop (running && left > 0) {
            var readers = [srv]
            var ready = select.select(readers, empty, empty, 0.05)
            if (len(ready[0]) > 0) {
                var pair = srv.accept()
                var client = pair[0]
                client.setblocking(true)
                work.putConn(client)
                left = left - 1
            }
        }
        work.putPoison()
        running = false
        srv.close()
    }

    task worker {
        bool done = false
        loop (!done) {
            var conn = work.takeConn()
            if (conn == null) {
                done = true
            } else {
                sharedHandler.serveOne(conn)
                served += 1
            }
        }
    }

    task client {
        loop (listenPort == 0) {
            time.sleep(0.01)
        }
        int port = listenPort
        var addr = ["127.0.0.1", port]
        var s = socket.create_connection(tuple(addr), 2.0)
        string req1 = "GET /health HTTP/1.1\r\nHost: localhost\r\nX-Correlation-Id: ka-1\r\nConnection: keep-alive\r\n\r\n"
        string req2 = "GET /health HTTP/1.1\r\nHost: localhost\r\nX-Correlation-Id: ka-2\r\nConnection: close\r\n\r\n"
        s.sendall(req1.encode("utf-8"))
        string buf = ""
        int rounds = 0
        loop (buf.find("200 OK") < 0 && rounds < 40) {
            var chunk = s.recv(4096)
            if (len(chunk) == 0) {
                rounds = 40
            } else {
                buf = buf + chunk.decode("utf-8")
            }
            rounds = rounds + 1
        }
        int firstOk = 0
        if (buf.find("200 OK") >= 0 && buf.find("keep-alive") >= 0) {
            firstOk = 1
        }
        s.sendall(req2.encode("utf-8"))
        string buf2 = ""
        rounds = 0
        loop (buf2.find("200 OK") < 0 && rounds < 40) {
            var chunk2 = s.recv(4096)
            if (len(chunk2) == 0) {
                rounds = 40
            } else {
                buf2 = buf2 + chunk2.decode("utf-8")
            }
            rounds = rounds + 1
        }
        s.close()
        int secondOk = 0
        if (buf2.find("200 OK") >= 0) {
            secondOk = 1
        }
        okResponses = firstOk + secondOk
        if (okResponses >= 2) {
            print("PASS e2e HTTP/1.1 keep-alive two requests one socket")
        } else {
            print("FAIL e2e keep-alive first=" + str(firstOk) + " second=" + str(secondOk))
            print(buf)
            print(buf2)
        }
        time.sleep(0.05)
        running = false
    }
}

if (okResponses >= 2) {
    print("PASS keepalive response count")
} else {
    print("FAIL keepalive response count")
}
if (served.get() >= 1) {
    print("PASS keepalive single connection served")
} else {
    print("FAIL keepalive single connection served")
}
print("=== http keepalive e2e done ===")
