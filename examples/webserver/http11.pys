# examples/webserver/http11.pys
# Minimal HTTP/1.1 request/response helpers (package).

package class HttpRequest {
    public string method
    public string path
    public string body
    public string correlationId

    public HttpRequest(string method, string path, string body, string correlationId) {
        this.method = method
        this.path = path
        this.body = body
        this.correlationId = correlationId
    }
}

package class HttpResponse {
    public int status
    public string reason
    public string body
    public string rejectReason

    public HttpResponse(int status, string reason, string body, string rejectReason) {
        this.status = status
        this.reason = reason
        this.body = body
        this.rejectReason = rejectReason
    }

    public string wire() {
        string payload = this.body
        string out = "HTTP/1.1 " + str(this.status) + " " + this.reason + "\r\n"
        out = out + "Content-Type: text/plain; charset=utf-8\r\n"
        out = out + "Content-Length: " + str(len(payload.encode("utf-8"))) + "\r\n"
        out = out + "Connection: close\r\n"
        if (this.rejectReason != "") {
            out = out + "X-Reject-Reason: " + this.rejectReason + "\r\n"
        }
        out = out + "\r\n" + payload
        return out
    }
}

package class Http11 {
    public Http11() {
    }

    public HttpRequest parse(string raw) {
        string method = "GET"
        string path = "/"
        string body = ""
        string correlationId = "corr-0"
        int headerEnd = raw.find("\r\n\r\n")
        string head = raw
        if (headerEnd >= 0) {
            head = raw[0:headerEnd]
            body = raw[headerEnd + 4:]
        }
        var lines = head.split("\r\n")
        if (len(lines) > 0) {
            var parts = lines[0].split(" ")
            if (len(parts) >= 2) {
                method = parts[0]
                path = parts[1]
            }
        }
        int qi = path.find("?")
        if (qi >= 0) {
            path = path[0:qi]
        }
        int i = 1
        loop (i < len(lines)) {
            string line = lines[i]
            int colon = line.find(":")
            if (colon > 0) {
                string name = line[0:colon].lower()
                string value = line[colon + 1:].strip()
                if (name == "x-correlation-id") {
                    correlationId = value
                }
            }
            i = i + 1
        }
        return HttpRequest(method, path, body, correlationId)
    }

    public void write(var conn, HttpResponse resp) {
        conn.sendall(resp.wire().encode("utf-8"))
    }

    public string readRaw(var conn) {
        string data = ""
        loop (true) {
            var chunk = conn.recv(4096)
            if (len(chunk) == 0) {
                return data
            }
            data = data + chunk.decode("utf-8")
            if (data.find("\r\n\r\n") >= 0) {
                return data
            }
            if (len(data) > 65536) {
                return data
            }
        }
        return data
    }
}
