# examples/webserver/http11.pys
# Minimal HTTP/1.1 request/response helpers (package). Keep-alive (FR2).

import select

package class HttpRequest {
    public string method
    public string path
    public string body
    public string correlationId
    public bool keepAlive

    public HttpRequest(string method, string path, string body, string correlationId, bool keepAlive) {
        this.method = method
        this.path = path
        this.body = body
        this.correlationId = correlationId
        this.keepAlive = keepAlive
    }
}

package class HttpResponse {
    public int status
    public string reason
    public string body
    public string rejectReason

    public HttpResponse(int status, string reason, string body, string rejectReason) {
        this.status = status
        this.reason = reason
        this.body = body
        this.rejectReason = rejectReason
    }

    public string wire(bool keepAlive) {
        string payload = this.body
        string out = "HTTP/1.1 " + str(this.status) + " " + this.reason + "\r\n"
        out = out + "Content-Type: text/plain; charset=utf-8\r\n"
        out = out + "Content-Length: " + str(len(payload.encode("utf-8"))) + "\r\n"
        if (keepAlive) {
            out = out + "Connection: keep-alive\r\n"
        } else {
            out = out + "Connection: close\r\n"
        }
        if (this.rejectReason != "") {
            out = out + "X-Reject-Reason: " + this.rejectReason + "\r\n"
        }
        out = out + "\r\n" + payload
        return out
    }
}

package class Http11 {
    public Http11() {
    }

    public HttpRequest parse(string raw) {
        string method = "GET"
        string path = "/"
        string body = ""
        string correlationId = "corr-0"
        # HTTP/1.1 default: keep-alive unless Connection: close
        bool keepAlive = true
        int headerEnd = raw.find("\r\n\r\n")
        string head = raw
        if (headerEnd >= 0) {
            head = raw[0:headerEnd]
            body = raw[headerEnd + 4:]
        }
        var lines = head.split("\r\n")
        if (len(lines) > 0) {
            var parts = lines[0].split(" ")
            if (len(parts) >= 2) {
                method = parts[0]
                path = parts[1]
            }
            if (len(parts) >= 3) {
                string ver = parts[2].upper()
                if (ver == "HTTP/1.0") {
                    keepAlive = false
                }
            }
        }
        int qi = path.find("?")
        if (qi >= 0) {
            path = path[0:qi]
        }
        int i = 1
        loop (i < len(lines)) {
            string line = lines[i]
            int colon = line.find(":")
            if (colon > 0) {
                string name = line[0:colon].lower()
                string value = line[colon + 1:].strip().lower()
                if (name == "x-correlation-id") {
                    correlationId = line[colon + 1:].strip()
                } else {
                    if (name == "connection") {
                        if (value.find("close") >= 0) {
                            keepAlive = false
                        } else {
                            if (value.find("keep-alive") >= 0) {
                                keepAlive = true
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
        return HttpRequest(method, path, body, correlationId, keepAlive)
    }

    public void write(var conn, HttpResponse resp, bool keepAlive) {
        conn.sendall(resp.wire(keepAlive).encode("utf-8"))
    }

    public string readRaw(var conn, float timeoutSec) {
        string data = ""
        var empty = []
        loop (true) {
            var readers = [conn]
            var ready = select.select(readers, empty, empty, timeoutSec)
            if (len(ready[0]) == 0) {
                return data
            }
            var chunk = conn.recv(4096)
            if (len(chunk) == 0) {
                return data
            }
            data = data + chunk.decode("utf-8")
            if (data.find("\r\n\r\n") >= 0) {
                return data
            }
            if (len(data) > 65536) {
                return data
            }
        }
        return data
    }
}
