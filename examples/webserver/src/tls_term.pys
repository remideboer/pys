# examples/webserver/tls_term.pys
# TLS 1.2/1.3 termination helper (FR5). ALPN advertises h2 + http/1.1 (FR2).

import ssl

package class TlsTerminator {
    public object context
    public bool enabled

    public constructor(bool enabled, string certFile, string keyFile) {
        this.enabled = enabled
        this.context = null
        if (enabled) {
            this.context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
            this.context.minimum_version = ssl.TLSVersion.TLSv1_2
            this.context.set_alpn_protocols(["h2", "http/1.1"])
            this.context.load_cert_chain(certFile, keyFile)
        }
    }

    public object wrap(conn) {
        if (!this.enabled) {
            return conn
        }
        return this.context.wrap_socket(conn, true)
    }
}
