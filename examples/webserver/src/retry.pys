# examples/webserver/retry.pys
# §6 retry policy + DownstreamCall contract (same package).
# FR8: executeOnPool acquires a fresh pool slot per attempt (spec §10.2).

import time
import random
import threading

import ServerConfig from config
import CircuitBreaker from circuit_breaker
import IdempotencyTable from idempotency
import DownstreamPool from pool
import MockDownstream, MockCall from mock_downstream

# DownstreamCall: implement invoke() → "ok" | "retryable" | "fatal" (ISP via package interface).
package interface DownstreamCall {
    string invoke()
}

package class RetryPolicy {
    private ServerConfig cfg
    private CircuitBreaker breaker
    private IdempotencyTable idem
    private int retryAttemptsTotal
    private object lock

    public RetryPolicy(ServerConfig cfg, CircuitBreaker breaker, IdempotencyTable idem) {
        this.cfg = cfg
        this.breaker = breaker
        this.idem = idem
        this.retryAttemptsTotal = 0
        this.lock = threading.Lock()
    }

    public void resetCounters() {
        this.lock.acquire()
        this.retryAttemptsTotal = 0
        this.lock.release()
    }

    public int attemptsTotal() {
        this.lock.acquire()
        int n = this.retryAttemptsTotal
        this.lock.release()
        return n
    }

    public float backoffSeconds(int attemptIndex) {
        float base = this.cfg.retryBaseMs / 1000.0
        float delay = base
        int i = 0
        loop (i < attemptIndex) {
            delay = delay * this.cfg.retryFactor
            i = i + 1
        }
        float jitter = 1.0 + (random.random() * 2.0 - 1.0) * this.cfg.retryJitter
        return delay * jitter
    }

    # FR8: each attempt = acquire → invoke → release; backoff holds no slot.
    # Returns ok | fatal | retryable | timeout | circuit_open | queue_full.
    public string executeOnPool(
        string method,
        string path,
        DownstreamPool pool,
        MockDownstream mock,
        int downstreamBudgetMs,
        float handlerBudgetSec
    ) {
        bool canRetry = this.cfg.retriesEnabled && this.idem.mayRetry(method, path)
        float started = time.monotonic()
        int attempt = 0
        loop (attempt < this.cfg.retryMaxAttempts) {
            float elapsed = time.monotonic() - started
            if (elapsed >= handlerBudgetSec) {
                return "timeout"
            }
            if (!this.breaker.allow()) {
                return "circuit_open"
            }
            if (!pool.acquire()) {
                return "queue_full"
            }
            MockCall call = MockCall(mock, downstreamBudgetMs)
            string result = call.invoke()
            pool.release()
            if (result == "ok") {
                this.breaker.onSuccess()
                return "ok"
            }
            if (result == "fatal") {
                this.breaker.onFailure()
                return "fatal"
            }
            this.breaker.onFailure()
            if (!canRetry) {
                return "retryable"
            }
            if (attempt + 1 >= this.cfg.retryMaxAttempts) {
                return "retryable"
            }
            if (!this.breaker.allow()) {
                return "circuit_open"
            }
            float backoff = this.backoffSeconds(attempt)
            elapsed = time.monotonic() - started
            if (elapsed + backoff >= handlerBudgetSec) {
                return "timeout"
            }
            this.lock.acquire()
            this.retryAttemptsTotal = this.retryAttemptsTotal + 1
            this.lock.release()
            time.sleep(backoff)
            attempt = attempt + 1
        }
        return "retryable"
    }

    # handlerBudgetSec: remaining wall time for the handler (FR6); skip retry sleep if exhausted.
    # Prefer executeOnPool when a DownstreamPool is involved (FR8).
    public string execute(string method, string path, call, float handlerBudgetSec) {
        bool canRetry = this.cfg.retriesEnabled && this.idem.mayRetry(method, path)
        float started = time.monotonic()
        int attempt = 0
        loop (attempt < this.cfg.retryMaxAttempts) {
            float elapsed = time.monotonic() - started
            if (elapsed >= handlerBudgetSec) {
                return "timeout"
            }
            if (!this.breaker.allow()) {
                return "circuit_open"
            }
            string result = call.invoke()
            if (result == "ok") {
                this.breaker.onSuccess()
                return "ok"
            }
            if (result == "fatal") {
                this.breaker.onFailure()
                return "fatal"
            }
            this.breaker.onFailure()
            if (!canRetry) {
                return "retryable"
            }
            if (attempt + 1 >= this.cfg.retryMaxAttempts) {
                return "retryable"
            }
            if (!this.breaker.allow()) {
                return "circuit_open"
            }
            float backoff = this.backoffSeconds(attempt)
            elapsed = time.monotonic() - started
            if (elapsed + backoff >= handlerBudgetSec) {
                return "timeout"
            }
            this.lock.acquire()
            this.retryAttemptsTotal = this.retryAttemptsTotal + 1
            this.lock.release()
            time.sleep(backoff)
            attempt = attempt + 1
        }
        return "retryable"
    }
}
