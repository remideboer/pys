# examples/webserver/conn_handler.pys
# Dispatch one accepted connection to HTTP/1.1 (keep-alive) or HTTP/2 (ALPN).

import Http11, HttpRequest from http11
import Http2Server from http2

package class ConnHandler {
    private Http11 http
    private Http2Server http2
    private object router
    private float idleTimeoutSec
    private float writeTimeoutSec

    public ConnHandler(
        Http11 http,
        Http2Server http2,
        object router,
        float idleTimeoutSec,
        float writeTimeoutSec
    ) {
        this.http = http
        this.http2 = http2
        this.router = router
        this.idleTimeoutSec = idleTimeoutSec
        this.writeTimeoutSec = writeTimeoutSec
    }

    public void serveOne(conn) {
        string alpn = ""
        if (hasattr(conn, "selected_alpn_protocol")) {
            var selected = conn.selected_alpn_protocol()
            if (selected != null) {
                alpn = str(selected)
            }
        }
        if (alpn == "h2") {
            this.http2.serve(conn, this.router, this.writeTimeoutSec)
        } else {
            this.serveHttp11(conn)
        }
        conn.close()
    }

    public void serveHttp11(conn) {
        # FR6 read/idle timeout on the socket; write deadline applied before send.
        conn.settimeout(this.idleTimeoutSec)
        bool open = true
        loop (open) {
            string raw = this.http.readRaw(conn, this.idleTimeoutSec)
            if (raw == "") {
                open = false
            } else {
                HttpRequest req = this.http.parse(raw)
                var resp = this.router.handle(req)
                conn.settimeout(this.writeTimeoutSec)
                this.http.write(conn, resp, req.keepAlive)
                conn.settimeout(this.idleTimeoutSec)
                if (!req.keepAlive) {
                    open = false
                }
            }
        }
    }
}
