# examples/webserver/mock_downstream.pys
# Local mock dependency with latency/error injection (Toxiproxy stand-in).

import time
import threading

package class MockDownstream {
    private var lock
    private int calls
    private int failNext
    private int latencyMs

    public MockDownstream() {
        this.lock = threading.Lock()
        this.calls = 0
        this.failNext = 0
        this.latencyMs = 0
    }

    public void setFailNext(int n) {
        this.lock.acquire()
        this.failNext = n
        this.lock.release()
    }

    public void setLatencyMs(int ms) {
        this.lock.acquire()
        this.latencyMs = ms
        this.lock.release()
    }

    public int callCount() {
        this.lock.acquire()
        int n = this.calls
        this.lock.release()
        return n
    }

    # Returns DownstreamCall-style status: ok | retryable | fatal
    # budgetMs: FR6 downstream call timeout — sleep at most this long, then timeout.
    public string invokeWithin(int budgetMs) {
        this.lock.acquire()
        this.calls = this.calls + 1
        int fail = this.failNext
        int delay = this.latencyMs
        if (fail > 0) {
            this.failNext = fail - 1
        }
        this.lock.release()
        int sleepMs = delay
        bool timedOut = false
        if (sleepMs > budgetMs) {
            sleepMs = budgetMs
            timedOut = true
        }
        if (sleepMs > 0) {
            time.sleep(sleepMs / 1000.0)
        }
        if (timedOut) {
            return "retryable"
        }
        if (fail > 0) {
            return "retryable"
        }
        return "ok"
    }

    public string invoke() {
        return this.invokeWithin(1000000)
    }
}

package class MockCall {
    private MockDownstream mock
    private int budgetMs

    public MockCall(MockDownstream mock, int budgetMs) {
        this.mock = mock
        this.budgetMs = budgetMs
    }

    public string invoke() {
        return this.mock.invokeWithin(this.budgetMs)
    }
}
