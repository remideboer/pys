# examples/webserver/main.pys
# Concurrent HTTP server: acceptor + workers; HTTP/1.1 or HTTP/2 via ALPN.
#
# Run:
#   python -m transpiler run examples/webserver/main.pys
#
# HTTPS + HTTP/2:
#   python examples/webserver/scripts/gen_dev_certs.py
#   # set cfg.tlsEnabled = true below
#   curl -k --http2 https://127.0.0.1:8080/health

import socket
import select
import time

import ServerConfig from config
import ConnQueue from conn_queue
import Http11 from http11
import Http2Server from http2
import ConnHandler from conn_handler
import AppContext, Router from router
import TlsTerminator from tls_term

ServerConfig cfg = ServerConfig()
# Set tlsEnabled = true (certs via scripts/gen_dev_certs.py) for HTTPS + HTTP/2 ALPN.
# cfg.tlsEnabled = true
AppContext ctx = AppContext(cfg)
Router router = Router(ctx)
Http11 http = Http11()
Http2Server http2 = Http2Server()
ConnHandler handler = ConnHandler(http, http2, router, 0.5)
TlsTerminator tls = TlsTerminator(cfg.tlsEnabled, cfg.tlsCertFile, cfg.tlsKeyFile)

shared ConnQueue work = ConnQueue()
shared bool running = true
shared ConnHandler sharedHandler = handler
shared TlsTerminator sharedTls = tls

print("starting concurrent webserver on " + cfg.listenHost + ":" + str(cfg.listenPort))
print("workers=4 (tasks) pool=" + str(cfg.poolSize) + " tls=" + str(cfg.tlsEnabled) + " alpn=h2,http/1.1")

tasks {
    task acceptor {
        var srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        var bindAddr = [cfg.listenHost, cfg.listenPort]
        srv.bind(tuple(bindAddr))
        srv.listen(128)
        srv.setblocking(false)
        print("listening")
        var empty = []
        loop (running) {
            var readers = [srv]
            var ready = select.select(readers, empty, empty, 0.5)
            var readable = ready[0]
            if (len(readable) > 0) {
                var pair = srv.accept()
                var client = pair[0]
                client.setblocking(true)
                client = sharedTls.wrap(client)
                work.putConn(client)
            }
        }
        int w = 0
        loop (w < cfg.workerTasks) {
            work.putPoison()
            w = w + 1
        }
        srv.close()
    }

    task worker0 {
        bool done = false
        loop (!done) {
            var conn = work.takeConn()
            if (conn == null) {
                done = true
            } else {
                sharedHandler.serveOne(conn)
            }
        }
    }

    task worker1 {
        bool done = false
        loop (!done) {
            var conn = work.takeConn()
            if (conn == null) {
                done = true
            } else {
                sharedHandler.serveOne(conn)
            }
        }
    }

    task worker2 {
        bool done = false
        loop (!done) {
            var conn = work.takeConn()
            if (conn == null) {
                done = true
            } else {
                sharedHandler.serveOne(conn)
            }
        }
    }

    task worker3 {
        bool done = false
        loop (!done) {
            var conn = work.takeConn()
            if (conn == null) {
                done = true
            } else {
                sharedHandler.serveOne(conn)
            }
        }
    }
}

print("server stopped")
