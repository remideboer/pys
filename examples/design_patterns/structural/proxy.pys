# Proxy — placeholder that controls access to a real subject.

interface Image {
    string display()
}

class RealImage implements Image {
    private string path

    public constructor(string path) {
        this.path = path
        print("load:" + path)
    }

    public string display() {
        return "show:" + this.path
    }
}

class ImageProxy implements Image {
    private string path
    private nullable<RealImage> real

    public constructor(string path) {
        this.path = path
        this.real = null
    }

    public string display() {
        if (this.real == null) {
            this.real = RealImage(this.path)
        }
        if (this.real != null) {
            return this.real.display()
        }
        return "missing"
    }
}

Image pic = ImageProxy("photo.png")
print(pic.display())  # load:photo.png then show:photo.png
print(pic.display())  # show:photo.png (already loaded)
