# Visitor — add operations over an object structure without changing elements.

interface ShapeVisitor {
    string visitDot(Dot dot)
    string visitCircle(Circle circle)
}

interface Shape {
    string accept(ShapeVisitor visitor)
}

class Dot implements Shape {
    private int x
    private int y

    public constructor(int x, int y) {
        this.x = x
        this.y = y
    }

    public int getX() {
        return this.x
    }

    public int getY() {
        return this.y
    }

    public string accept(ShapeVisitor visitor) {
        return visitor.visitDot(this)
    }
}

class Circle implements Shape {
    private int radius

    public constructor(int radius) {
        this.radius = radius
    }

    public int getRadius() {
        return this.radius
    }

    public string accept(ShapeVisitor visitor) {
        return visitor.visitCircle(this)
    }
}

class DescribeVisitor implements ShapeVisitor {
    public constructor() {
    }

    public string visitDot(Dot dot) {
        return "dot@" + str(dot.getX()) + "," + str(dot.getY())
    }

    public string visitCircle(Circle circle) {
        return "circle r=" + str(circle.getRadius())
    }
}

Shape a = Dot(1, 2)
Shape b = Circle(4)
ShapeVisitor v = DescribeVisitor()
print(a.accept(v))  # dot@1,2
print(b.accept(v))  # circle r=4
