# Interpreter — tiny expression language as an object tree.
# Modern note: use only for small DSLs; prefer a real parser for large languages.

interface Expr {
    int eval()
}

class Number implements Expr {
    private int value

    public constructor(int value) {
        this.value = value
    }

    public int eval() {
        return this.value
    }
}

class Add implements Expr {
    private Expr left
    private Expr right

    public constructor(Expr left, Expr right) {
        this.left = left
        this.right = right
    }

    public int eval() {
        return this.left.eval() + this.right.eval()
    }
}

class Mul implements Expr {
    private Expr left
    private Expr right

    public constructor(Expr left, Expr right) {
        this.left = left
        this.right = right
    }

    public int eval() {
        return this.left.eval() * this.right.eval()
    }
}

# (1 + 2) * 3
Expr tree = Mul(Add(Number(1), Number(2)), Number(3))
print(tree.eval())  # 9
