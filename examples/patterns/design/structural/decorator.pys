# Decorator — wrap an object to add behavior without changing its class.

interface Notifier {
    string send(string message)
}

class EmailNotifier implements Notifier {
    public constructor() {
    }

    public string send(string message) {
        return "email:" + message
    }
}

abstract class NotifierDecorator implements Notifier {
    protected Notifier wrappee

    public constructor(Notifier wrappee) {
        this.wrappee = wrappee
    }

    public abstract string send(string message)
}

class SmsDecorator inherits NotifierDecorator {
    public constructor(Notifier wrappee) {
        super(wrappee)
    }

    public override string send(string message) {
        return this.wrappee.send(message) + "+sms:" + message
    }
}

class SlackDecorator inherits NotifierDecorator {
    public constructor(Notifier wrappee) {
        super(wrappee)
    }

    public override string send(string message) {
        return this.wrappee.send(message) + "+slack:" + message
    }
}

Notifier stack = SlackDecorator(SmsDecorator(EmailNotifier()))
print(stack.send("hi"))  # email:hi+sms:hi+slack:hi
