# State — behavior changes with internal state objects.

interface PlayerState {
    string play(Player player)
    string pause(Player player)
}

class Player {
    private PlayerState state

    public constructor(PlayerState state) {
        this.state = state
    }

    public void changeState(PlayerState state) {
        this.state = state
    }

    public string play() {
        return this.state.play(this)
    }

    public string pause() {
        return this.state.pause(this)
    }
}

class StoppedState implements PlayerState {
    public constructor() {
    }

    public string play(Player player) {
        player.changeState(PlayingState())
        return "start"
    }

    public string pause(Player player) {
        return "already-stopped"
    }
}

class PlayingState implements PlayerState {
    public constructor() {
    }

    public string play(Player player) {
        return "already-playing"
    }

    public string pause(Player player) {
        player.changeState(StoppedState())
        return "paused"
    }
}

Player p = Player(StoppedState())
print(p.play())  # start
print(p.play())  # already-playing
print(p.pause())  # paused
print(p.pause())  # already-stopped
