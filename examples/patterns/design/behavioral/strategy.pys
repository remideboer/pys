# Strategy — swap algorithms behind a common interface.

interface PricingStrategy {
    int price(int cents)
}

class RegularPrice implements PricingStrategy {
    public constructor() {
    }

    public int price(int cents) {
        return cents
    }
}

class MemberPrice implements PricingStrategy {
    public constructor() {
    }

    public int price(int cents) {
        return cents - 100
    }
}

class Cart {
    private PricingStrategy strategy

    public constructor(PricingStrategy strategy) {
        this.strategy = strategy
    }

    public void setStrategy(PricingStrategy strategy) {
        this.strategy = strategy
    }

    public int checkout(int cents) {
        return this.strategy.price(cents)
    }
}

Cart cart = Cart(RegularPrice())
print(cart.checkout(1000))  # 1000
cart.setStrategy(MemberPrice())
print(cart.checkout(1000))  # 900
