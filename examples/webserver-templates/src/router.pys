import HttpRequest, HttpResponse from http11
import TemplateEngine from template_engine

package class Router {
    private TemplateEngine engine

    public constructor(TemplateEngine engine) {
        this.engine = engine
    }

    public HttpResponse handle(HttpRequest req) {
        if (req.method != "GET") {
            return HttpResponse(405, "Method Not Allowed", "method not allowed", "text/plain; charset=utf-8")
        }
        if (req.path == "/health") {
            return HttpResponse(200, "OK", "ok", "text/plain; charset=utf-8")
        }
        if (req.path == "/" || req.path == "/hello") {
            dict ctx = dict()
            ctx["title"] = "Hello"
            ctx["name"] = "Ada"
            string htmlBody = this.engine.render("hello.html", ctx)
            if (htmlBody == "") {
                return HttpResponse(500, "Error", "template missing", "text/plain; charset=utf-8")
            }
            return HttpResponse(200, "OK", htmlBody, "text/html; charset=utf-8")
        }
        if (req.path == "/greet") {
            dict ctx = dict()
            ctx["title"] = "Greetings"
            ctx["name"] = "Remi"
            string htmlBody = this.engine.render("hello.html", ctx)
            return HttpResponse(200, "OK", htmlBody, "text/html; charset=utf-8")
        }
        return HttpResponse(404, "Not Found", "not found", "text/plain; charset=utf-8")
    }
}
