# Abstract classes: toy forms first, then a fuller template-method sample.
# Contrast with interface (no state/bodies) and trait (composition, not is-a).
#
# Litmus test used below: shared code must call a method that *varies* across
# more than one concrete subclass. One subclass alone would not justify abstract.

# --- Toy 1: shared hello(); two different name() strategies ---
# Without a second greeter, NamedGreeter alone could own hello() — no abstract.
# With two forms, hello() stays written once and dispatches via name().
abstract class Greeter {
    public constructor() {
    }

    public string hello() {
        return "hi " + this.name()
    }

    public abstract string name()
}

# Form A: plain personal name.
class NamedGreeter inherits Greeter {
    private string who

    public constructor(string who) {
        super()
        this.who = who
    }

    public override string name() {
        return this.who
    }
}

# Form B: title + name (different storage / formatting of "who am I").
class TitledGreeter inherits Greeter {
    private string title
    private string who

    public constructor(string title, string who) {
        super()
        this.title = title
        this.who = who
    }

    public override string name() {
        return this.title + " " + this.who
    }
}

NamedGreeter g = NamedGreeter("Ada")
TitledGreeter t = TitledGreeter("Dr", "Ada")
print(g.hello())  # hi Ada
print(t.hello())  # hi Dr Ada

# Same template, different subclasses — static type is Greeter.
Greeter first = g
Greeter second = t
print(first.hello())  # hi Ada
print(second.hello())  # hi Dr Ada

# --- Toy 2: abstract void bump(); two step strategies ---
# value() is shared; bump() must differ (plus-one vs plus-ten) or abstract is pointless.
abstract class Counter {
    protected int n

    public constructor() {
        this.n = 0
    }

    public int value() {
        return this.n
    }

    public abstract void bump()
}

class PlusOne inherits Counter {
    public constructor() {
        super()
    }

    public override void bump() {
        this.n = this.n + 1
    }
}

class PlusTen inherits Counter {
    public constructor() {
        super()
    }

    public override void bump() {
        this.n = this.n + 10
    }
}

PlusOne c1 = PlusOne()
PlusTen c10 = PlusTen()
c1.bump()
c1.bump()
c10.bump()
print(c1.value())  # 2
print(c10.value())  # 10

# Polymorphic: same Counter API, different bump implementations.
Counter left = c1
Counter right = c10
left.bump()
right.bump()
print(left.value())  # 3
print(right.value())  # 20

# =============================================================================
# Fuller sample: shared list state + two storage strategies
# (fixed slots / link nodes — no T[] yet so the sample stays runnable)
# Why abstract: contains()/isEmpty() are identical for every list; get()/add()
# cannot be — array indexing vs link walking. One storage type alone would not
# need AbstractList; two strategies make the shared template earn its keep.
# =============================================================================

# --- Abstract base: shared size/modCount + template methods ---
# isEmpty needs only size. contains calls abstract get() -- each subclass
# supplies storage; the loop body is written once (template method).
abstract class AbstractList {
    protected int size
    protected int modCount

    public constructor() {
        this.size = 0
        this.modCount = 0
    }

    public bool isEmpty() {
        return this.size == 0
    }

    public bool contains(string item) {
        loop (int i = 0; i < this.size; i++) {
            if (this.get(i) == item) {
                return true
            }
        }
        return false
    }

    # Variation points: no shared body possible across storage strategies.
    public abstract string get(int index)
    public abstract void add(string item)
}

# --- Intermediate abstract class: still not instantiable ---
# Adds a concrete helper that subclasses inherit, but leaves get/add abstract.
# Concrete classes must still implement every inherited abstract method.
abstract class AbstractCountedList inherits AbstractList {
    public constructor() {
        super()
    }

    # Shared bookkeeping used by both storage strategies after a successful add.
    public void touch() {
        this.modCount = this.modCount + 1
    }

    public int mutations() {
        return this.modCount
    }
}

# --- Storage 1: contiguous slots (simplified array list) ---
class ArrayListPys inherits AbstractCountedList {
    private string item0
    private string item1
    private string item2

    public constructor() {
        super()
        this.item0 = ""
        this.item1 = ""
        this.item2 = ""
    }

    public override string get(int index) {
        if (index == 0) {
            return this.item0
        }
        if (index == 1) {
            return this.item1
        }
        return this.item2
    }

    public override void add(string item) {
        if (this.size == 0) {
            this.item0 = item
        }
        else if (this.size == 1) {
            this.item1 = item
        }
        else {
            this.item2 = item
        }
        this.size = this.size + 1
        this.touch()
    }
}

# --- Link node for storage 2 (class, not struct: next may be unset until linked) ---
class Link {
    private string value
    private Link next
    private bool hasNext

    public constructor(string value) {
        this.value = value
        this.hasNext = false
    }

    public void setNext(Link next) {
        this.next = next
        this.hasNext = true
    }

    public string getValue() {
        return this.value
    }

    public bool linked() {
        return this.hasNext
    }

    public Link getNext() {
        return this.next
    }
}

# --- Storage 2: prepend linked list (O(n) get, O(1) add at head) ---
class LinkedListPys inherits AbstractCountedList {
    private Link head
    private bool hasHead

    public constructor() {
        super()
        this.hasHead = false
    }

    public override string get(int index) {
        Link cur = this.head
        loop (int i = 0; i < index; i++) {
            cur = cur.getNext()
        }
        return cur.getValue()
    }

    public override void add(string item) {
        Link node = Link(item)
        if (this.hasHead) {
            node.setNext(this.head)
        }
        this.head = node
        this.hasHead = true
        this.size = this.size + 1
        this.touch()
    }
}

# --- Polymorphic helper: static type is the abstract class ---
function bool hasItem(AbstractList list, string item) {
    return list.contains(item)
}

# --- Drive both strategies: same contains(), different get()/add() ---
ArrayListPys xs = ArrayListPys()
print(xs.isEmpty())  # true
xs.add("a")
xs.add("b")
print(xs.isEmpty())  # false
print(xs.get(0))  # a  (index 0 = first appended)
print(xs.contains("b"))  # true  -- template uses ArrayListPys.get
print(xs.contains("z"))  # false
print(xs.mutations())  # 2

# Polymorphic binding + free function taking AbstractList.
AbstractList view = xs
print(view.contains("a"))  # true
print(hasItem(view, "b"))  # true

# Linked list: add prepends, so get(0) is the last inserted item.
LinkedListPys ys = LinkedListPys()
ys.add("a")
ys.add("b")
print(ys.get(0))  # b
print(ys.get(1))  # a
print(hasItem(ys, "a"))  # true -- same hasItem/contains, different get
print(ys.mutations())  # 2

# Same template method, different storage -- both are AbstractCountedList.
AbstractCountedList listsA = xs
AbstractCountedList listsB = ys
print(listsA.contains("a"))  # true
print(listsB.contains("b"))  # true
