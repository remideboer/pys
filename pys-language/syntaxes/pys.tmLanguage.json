{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode-TextMate/master/grammar.json",
  "name": "PYS",
  "scopeName": "source.pys",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#strings"
    },
    {
      "name": "storage.type.pys",
      "match": "\\bvar\\b"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#generics"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "decorators": {
      "patterns": [
        {
          "name": "meta.function.decorator.pys",
          "begin": "(@)((?:[A-Za-z_]\\w*\\s*\\.\\s*)*[A-Za-z_]\\w*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.decorator.pys"
            },
            "2": {
              "name": "entity.name.function.decorator.pys"
            },
            "3": {
              "name": "punctuation.definition.parameters.begin.bracket.round.pys"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.end.bracket.round.pys"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#identifiers"
            }
          ]
        },
        {
          "name": "meta.function.decorator.pys",
          "match": "(@)((?:[A-Za-z_]\\w*\\s*\\.\\s*)*[A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.decorator.pys"
            },
            "2": {
              "name": "entity.name.function.decorator.pys"
            }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.pys",
          "begin": "##",
          "end": "/#"
        },
        {
          "name": "comment.line.number-sign.pys",
          "begin": "#(?![sficbo]\\{)",
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pys",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pys",
              "match": "\\\\.|\\\\#"
            },
            {
              "name": "meta.interpolation.typed.pys",
              "begin": "#[sficbo]\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.begin.pys"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.end.pys"
                }
              },
              "patterns": [
                {
                  "include": "#identifiers"
                },
                {
                  "include": "#numbers"
                }
              ]
            },
            {
              "name": "meta.interpolation.pys",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.begin.pys"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.end.pys"
                }
              },
              "patterns": [
                {
                  "include": "#identifiers"
                },
                {
                  "include": "#numbers"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.pys",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pys",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.array.declaration.pys",
          "match": "\\b(int|float|char|string|bool|byte|nibble|int16|int32|int64|dword)(?:\\[(\\d*)\\])+\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.primitive.pys"
            },
            "2": {
              "name": "constant.numeric.integer.pys"
            },
            "3": {
              "name": "variable.other.pys"
            }
          }
        },
        {
          "name": "meta.const.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(const)\\s+(int|float|char|string|bool|byte|nibble|int16|int32|int64|dword)\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.modifier.pys"
            },
            "3": {
              "name": "storage.type.primitive.pys"
            },
            "4": {
              "name": "variable.other.constant.pys"
            }
          }
        },
        {
          "name": "meta.fix.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(fix)\\s+(?:(int|float|char|string|bool|byte|nibble|int16|int32|int64|dword)|((?!struct\\b|data\\b|entity\\b|enum\\b|class\\b|interface\\b|trait\\b|function\\b|func\\b)[A-Za-z_]\\w*(?:\\s*<[^>\\n]+>)?))\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.modifier.pys"
            },
            "3": {
              "name": "storage.type.primitive.pys"
            },
            "4": {
              "name": "entity.name.type.pys"
            },
            "5": {
              "name": "variable.other.constant.pys"
            }
          }
        },
        {
          "name": "meta.shared.declaration.pys",
          "match": "\\b(shared)\\s+(int|float|char|string|bool|byte|nibble|int16|int32|int64|dword|[A-Za-z_]\\w*)\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.type.primitive.pys"
            },
            "3": {
              "name": "variable.other.pys"
            }
          }
        },
        {
          "name": "meta.atomic.declaration.pys",
          "match": "\\b(atomic)\\s+(int|int16|int32|int64|dword|bool)\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.type.primitive.pys"
            },
            "3": {
              "name": "variable.other.pys"
            }
          }
        },
        {
          "name": "meta.tasks.declaration.pys",
          "match": "\\b(tasks)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.pys"
            }
          }
        },
        {
          "name": "meta.task.declaration.pys",
          "match": "\\b(task)(?:\\s+([A-Za-z_]\\w*))?\\b",
          "captures": {
            "1": {
              "name": "keyword.control.pys"
            },
            "2": {
              "name": "entity.name.function.pys"
            }
          }
        },
        {
          "name": "storage.modifier.pys",
          "match": "\\b(global|package|module)(?=\\s+(?:function|func|(?:(?:closed|abstract)\\s+)?class|(?:fix\\s+)?struct|data|entity|enum|interface|trait|const|fix)\\b)"
        },
        {
          "name": "meta.struct.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(?:(fix)\\s+)?(struct)\\s+([A-Za-z_]\\w*)(?:(<)([A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*)(>))?",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.modifier.pys"
            },
            "3": {
              "name": "keyword.control.pys"
            },
            "4": {
              "name": "entity.name.type.struct.pys"
            },
            "5": {
              "name": "punctuation.definition.typeparameters.begin.pys"
            },
            "6": {
              "name": "storage.type.primitive.pys"
            },
            "7": {
              "name": "punctuation.definition.typeparameters.end.pys"
            }
          }
        },
        {
          "name": "meta.data.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(data)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "keyword.control.pys"
            },
            "3": {
              "name": "entity.name.type.data.pys"
            }
          }
        },
        {
          "name": "meta.entity.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(entity)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "keyword.control.pys"
            },
            "3": {
              "name": "entity.name.type.entity.pys"
            }
          }
        },
        {
          "name": "meta.enum.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(enum)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "keyword.control.pys"
            },
            "3": {
              "name": "entity.name.type.enum.pys"
            }
          }
        },
        {
          "name": "meta.function.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(function|func)\\s+(?:((?:result|nullable)\\s*<[^>\\n]+>|int|float|char|string|bool|byte|nibble|int16|int32|int64|dword)\\s+)?([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "keyword.control.pys"
            },
            "3": {
              "name": "storage.type.primitive.pys"
            },
            "4": {
              "name": "entity.name.function.pys"
            }
          }
        },
        {
          "name": "meta.class.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(?:(closed|abstract)\\s+)?(class)\\s+([A-Za-z_]\\w*)(?:(<)([A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*)(>))?(?:\\s+(inherits|super)\\s+([A-Za-z_]\\w*))?(?:\\s+(uses)\\s+([A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*))?(?:\\s+(implements)\\s+([A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*))?",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.modifier.pys"
            },
            "3": {
              "name": "keyword.control.pys"
            },
            "4": {
              "name": "entity.name.type.class.pys"
            },
            "5": {
              "name": "punctuation.definition.typeparameters.begin.pys"
            },
            "6": {
              "name": "storage.type.primitive.pys"
            },
            "7": {
              "name": "punctuation.definition.typeparameters.end.pys"
            },
            "8": {
              "name": "keyword.control.pys"
            },
            "9": {
              "name": "entity.name.type.class.pys"
            },
            "10": {
              "name": "keyword.control.pys"
            },
            "11": {
              "name": "entity.name.type.pys"
            },
            "12": {
              "name": "keyword.control.pys"
            },
            "13": {
              "name": "entity.name.type.interface.pys"
            }
          }
        },
        {
          "name": "meta.interface.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(interface)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "keyword.control.pys"
            },
            "3": {
              "name": "entity.name.type.interface.pys"
            }
          }
        },
        {
          "name": "meta.trait.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(trait)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "keyword.control.pys"
            },
            "3": {
              "name": "entity.name.type.pys"
            }
          }
        },
        {
          "name": "meta.import.pys",
          "begin": "\\b(import)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.pys"
            }
          },
          "end": "$",
          "patterns": [
            {
              "match": "\\b(all|from)\\b",
              "name": "keyword.control.pys"
            },
            {
              "match": "[A-Za-z_][\\w]*",
              "name": "entity.name.namespace.pys"
            },
            {
              "match": "\\.",
              "name": "punctuation.accessor.pys"
            },
            {
              "match": ",",
              "name": "punctuation.separator.pys"
            }
          ]
        },
        {
          "name": "meta.field.declaration.pys",
          "match": "(?:\\b(public|private|protected|module)\\s+)?(?:(static)\\s+)?(?:(fix|const)\\s+)?(?:((?:result|nullable|list|dict|tuple|set|lambda)\\s*<[^>\\n]+>|int|float|char|string|bool|void|object|byte|nibble|int16|int32|int64|dword)|((?!public\\b|private\\b|protected\\b|module\\b|global\\b|package\\b|static\\b|fix\\b|const\\b|open\\b|override\\b|closed\\b|abstract\\b|constructor\\b|struct\\b|data\\b|entity\\b|enum\\b|class\\b|interface\\b|trait\\b|function\\b|func\\b|var\\b|if\\b|else\\b|loop\\b|while\\b|for\\b|return\\b|shared\\b|atomic\\b|tasks\\b|task\\b|nullable\\b|result\\b|object\\b|import\\b|from\\b|switch\\b|case\\b|default\\b|this\\b|super\\b)[A-Za-z_]\\w*(?:\\s*<[^>\\n]+>)?))\\s+([A-Za-z_]\\w*)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.modifier.pys"
            },
            "3": {
              "name": "storage.modifier.pys"
            },
            "4": {
              "name": "storage.type.primitive.pys"
            },
            "5": {
              "name": "entity.name.type.pys"
            },
            "6": {
              "name": "variable.other.pys"
            }
          }
        },
        {
          "name": "meta.method.declaration.pys",
          "match": "(?:\\b(public|private|protected|module)\\s+)?(?:(static)\\s+)?(?:(abstract)\\s+)?(?:(open|override(?:\\s+closed)?|closed)\\s+)?(?:((?:result|nullable|list|dict|tuple|set|lambda)\\s*<[^>\\n]+>|int|float|char|string|bool|void|object|byte|nibble|int16|int32|int64|dword)|((?!public\\b|private\\b|protected\\b|module\\b|static\\b|abstract\\b|open\\b|override\\b|closed\\b|constructor\\b|struct\\b|data\\b|entity\\b|enum\\b|class\\b|interface\\b|trait\\b|function\\b|func\\b|var\\b|if\\b|return\\b|shared\\b|atomic\\b|tasks\\b|task\\b|nullable\\b|result\\b|object\\b|print\\b)[A-Za-z_]\\w*(?:\\s*<[^>\\n]+>)?))?\\s*([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.modifier.pys"
            },
            "3": {
              "name": "storage.modifier.pys"
            },
            "4": {
              "name": "storage.modifier.pys"
            },
            "5": {
              "name": "storage.type.primitive.pys"
            },
            "6": {
              "name": "entity.name.type.pys"
            },
            "7": {
              "name": "entity.name.function.pys"
            }
          }
        },
        {
          "name": "meta.var.declaration.pys",
          "match": "\\b(var)\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.primitive.pys"
            },
            "2": {
              "name": "variable.other.pys"
            }
          }
        },
        {
          "name": "meta.typed.declaration.pys",
          "match": "\\b(?:((?:result|nullable|list|dict|tuple|set|lambda)\\s*<[^>\\n]+>|int|float|char|string|bool|object|byte|nibble|int16|int32|int64|dword)|((?!public\\b|private\\b|protected\\b|module\\b|global\\b|package\\b|static\\b|open\\b|override\\b|closed\\b|abstract\\b|constructor\\b|struct\\b|data\\b|entity\\b|enum\\b|class\\b|interface\\b|trait\\b|function\\b|func\\b|var\\b|const\\b|fix\\b|if\\b|else\\b|loop\\b|while\\b|for\\b|return\\b|shared\\b|atomic\\b|tasks\\b|task\\b|nullable\\b|result\\b|object\\b|import\\b|from\\b|switch\\b|case\\b|default\\b|this\\b|super\\b|true\\b|false\\b|null\\b)[A-Za-z_]\\w*(?:\\s*<[^>\\n]+>)?))\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.primitive.pys"
            },
            "2": {
              "name": "entity.name.type.pys"
            },
            "3": {
              "name": "variable.other.pys"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.pys",
          "match": "\\b(?:public|private|protected|module|global|package|const|fix|closed|open|override|abstract|constructor|static|shared|atomic)\\b"
        },
        {
          "name": "keyword.control.conditional.pys",
          "match": "\\belse\\s+if\\b"
        },
        {
          "name": "storage.type.primitive.pys",
          "match": "\\bvar\\b"
        },
        {
          "name": "keyword.control.pys",
          "match": "\\b(?:if|else|elseif|while|for|loop|func|function|class|struct|data|entity|identity|lambda|enum|interface|trait|implements|inherits|uses|requires|return|repeat|times|import|from|all|break|continue|pass|unless|switch|case|default|not|and|or|xor|shift|this|super|tasks|task|await|atomic|propagate|nullable)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.pys",
          "match": "\\b(?:var|int|float|char|bool|str|string|void|object|list|dict|tuple|set|result|nullable)\\b"
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "name": "meta.type.parameters.pys",
          "begin": "\\b((?:list|dict|tuple|set)|(?:[A-Z][A-Za-z0-9_]*))\\s*(<)(?=\\s*(?:int|float|char|string|bool|list|dict|tuple|set|[A-Z][A-Za-z0-9_]*)\\b)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.primitive.pys"
            },
            "2": {
              "name": "punctuation.definition.typeparameters.begin.pys"
            }
          },
          "end": ">",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.pys"
            }
          },
          "patterns": [
            {
              "include": "#generics"
            },
            {
              "include": "#types"
            },
            {
              "name": "punctuation.separator.typeparameters.pys",
              "match": ","
            },
            {
              "name": "entity.name.type.pys",
              "match": "\\b[A-Za-z_]\\w*\\b"
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.pys",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.pys",
          "match": "\\b(?:print|ok|error|parseFloat|parseInt|input|toBin|toHex|toOct)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.pys",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.binary.pys",
          "match": "\\b0[bB][01]+(?:_[01]+)*\\b"
        },
        {
          "name": "constant.numeric.hex.pys",
          "match": "\\b0[xX][0-9A-Fa-f]+(?:_[0-9A-Fa-f]+)*\\b"
        },
        {
          "name": "constant.numeric.integer.pys",
          "match": "\\b\\d+(?:_\\d+)*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pys",
          "match": "\\+\\+|--|<<<|>>>|<<|>>|=>|\\*\\*|//|<=|>=|==|!=|<>|[+\\-*/%!=<>&|^~]|\\bxor\\b|\\bshift\\s+(?:left|right)\\b"
        },
        {
          "name": "invalid.illegal.pys",
          "match": ";"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.pys",
          "match": "\\b[A-Za-z_]\\w*\\b"
        }
      ]
    }
  }
}
