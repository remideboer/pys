{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode-textmate/master/grammar.json",
  "name": "PYS",
  "scopeName": "source.pys",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pys",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pys",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pys",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.pys",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pys",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.pys",
          "match": "\\b(?:public|private|protected|module)\\b"
        },
        {
          "name": "keyword.control.pys",
          "match": "\\b(?:if|else|elseif|else\\s+if|while|for|loop|func|function|class|return|repeat|times|import|from|let|break|continue|pass|unless|int|float|bool|str|string|true|false|null|this)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.pys",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.pys",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pys",
          "match": "[+\\-*/%!=<>]+"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.pys",
          "match": "\\b[A-Za-z_]\\w*\\b"
        }
      ]
    }
  }
}
