{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode-TextMate/master/grammar.json",
  "name": "PYS",
  "scopeName": "source.pys",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "name": "storage.type.pys",
      "match": "\\bvar\\b"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.pys",
          "begin": "##",
          "end": "/#"
        },
        {
          "name": "comment.line.number-sign.pys",
          "match": "#(?![sficbo]\\{).*?$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pys",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pys",
              "match": "\\\\.|\\\\#"
            },
            {
              "name": "meta.interpolation.typed.pys",
              "begin": "#[sficbo]\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.begin.pys"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.end.pys"
                }
              },
              "patterns": [
                {
                  "include": "#identifiers"
                },
                {
                  "include": "#numbers"
                }
              ]
            },
            {
              "name": "meta.interpolation.pys",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.begin.pys"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.end.pys"
                }
              },
              "patterns": [
                {
                  "include": "#identifiers"
                },
                {
                  "include": "#numbers"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.pys",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pys",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.array.declaration.pys",
          "match": "\\b(int|float|char|string|bool)\\[(\\d*)\\]\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.pys"
            },
            "2": {
              "name": "constant.numeric.integer.pys"
            },
            "3": {
              "name": "variable.other.pys"
            }
          }
        },
        {
          "name": "meta.const.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(const)\\s+(int|float|char|string|bool)\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.modifier.pys"
            },
            "3": {
              "name": "storage.type.pys"
            },
            "4": {
              "name": "variable.other.constant.pys"
            }
          }
        },
        {
          "name": "meta.fix.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(fix)\\s+(int|float|char|string|bool)\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.modifier.pys"
            },
            "3": {
              "name": "storage.type.pys"
            },
            "4": {
              "name": "variable.other.constant.pys"
            }
          }
        },
        {
          "name": "storage.modifier.pys",
          "match": "\\b(global|package|module)(?=\\s+(?:function|func|(?:sealed\\s+)?class|interface|const|fix)\\b)"
        },
        {
          "name": "meta.function.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(function|func)\\s+(?:(int|float|char|string|bool)\\s+)?([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "keyword.control.pys"
            },
            "3": {
              "name": "storage.type.pys"
            },
            "4": {
              "name": "entity.name.function.pys"
            }
          }
        },
        {
          "name": "meta.class.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(?:(sealed)\\s+)?(class)\\s+([A-Za-z_]\\w*)(?:<([A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*)>)?(?:\\s+(inherits|super)\\s+([A-Za-z_]\\w*))?(?:\\s+(implements)\\s+([A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*))?",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.modifier.pys"
            },
            "3": {
              "name": "keyword.control.pys"
            },
            "4": {
              "name": "entity.name.type.class.pys"
            },
            "5": {
              "name": "storage.type.pys"
            },
            "6": {
              "name": "keyword.control.pys"
            },
            "7": {
              "name": "entity.name.type.class.pys"
            },
            "8": {
              "name": "keyword.control.pys"
            },
            "9": {
              "name": "entity.name.type.interface.pys"
            }
          }
        },
        {
          "name": "meta.interface.declaration.pys",
          "match": "\\b(?:(global|package|module)\\s+)?(interface)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "keyword.control.pys"
            },
            "3": {
              "name": "entity.name.type.interface.pys"
            }
          }
        },
        {
          "name": "meta.import.pys",
          "match": "\\b(import)\\s+(?:(all)\\s+(from)\\s+(.+)|([A-Za-z_]\\w*)\\s+(from)\\s+(.+)|(.+))",
          "captures": {
            "1": {
              "name": "keyword.control.pys"
            },
            "2": {
              "name": "keyword.control.pys"
            },
            "3": {
              "name": "keyword.control.pys"
            },
            "4": {
              "name": "entity.name.namespace.pys"
            },
            "5": {
              "name": "variable.other.pys"
            },
            "6": {
              "name": "keyword.control.pys"
            },
            "7": {
              "name": "entity.name.namespace.pys"
            },
            "8": {
              "name": "entity.name.namespace.pys"
            }
          }
        },
        {
          "name": "meta.method.declaration.pys",
          "match": "\\b(public|private|protected|module)\\s+(?:(int|float|char|string|bool)\\s+)?([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.modifier.pys"
            },
            "2": {
              "name": "storage.type.pys"
            },
            "3": {
              "name": "entity.name.function.pys"
            }
          }
        },
        {
          "name": "meta.var.declaration.pys",
          "match": "\\b(var)\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.pys"
            },
            "2": {
              "name": "variable.other.pys"
            }
          }
        },
        {
          "name": "meta.typed.declaration.pys",
          "match": "\\b(int|float|char|string|bool)\\s+([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.pys"
            },
            "2": {
              "name": "variable.other.pys"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.pys",
          "match": "\\b(?:public|private|protected|module|global|package|const|fix|sealed)\\b"
        },
        {
          "name": "keyword.control.conditional.pys",
          "match": "\\belse\\s+if\\b"
        },
        {
          "name": "storage.type.pys",
          "match": "\\bvar\\b"
        },
        {
          "name": "keyword.control.pys",
          "match": "\\b(?:if|else|elseif|while|for|loop|func|function|class|interface|implements|inherits|return|repeat|times|import|from|all|break|continue|pass|unless|not|and|or|this|super)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.pys",
          "match": "\\b(?:var|int|float|char|bool|str|string)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.pys",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.pys",
          "match": "\\b(?:print)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.pys",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.pys",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pys",
          "match": "[+\\-*/%!=<>&|]+|\\+\\+|--"
        },
        {
          "name": "invalid.illegal.pys",
          "match": ";"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.pys",
          "match": "\\b[A-Za-z_]\\w*\\b"
        }
      ]
    }
  }
}
