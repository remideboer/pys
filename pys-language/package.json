{
  "name": "pys-language",
  "displayName": "PYS Language Support",
  "description": "Syntax highlighting, snippets, diagnostics, and run/debug for the PYS teaching language.",
  "version": "0.0.28",
  "publisher": "local",
  "private": true,
  "icon": "icons/pys-icon.png",
  "scripts": {},
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "PYS",
      "properties": {
        "pys.mainFile": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative path to the main .pys entry file (for example examples/main.pys). Used by Run/Debug Main."
        },
        "pys.libraryTyping.usageTips": {
          "type": "boolean",
          "default": false,
          "description": "Show optional tips for using weakly typed Python library values in a typed way (for example typed loop variables)."
        }
      }
    },
    "languages": [
      {
        "id": "pys",
        "aliases": ["PYS", "pys"],
        "extensions": [".pys"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pys-light.svg",
          "dark": "./icons/pys-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pys",
        "scopeName": "source.pys",
        "path": "./syntaxes/pys.tmLanguage.json"
      },
      {
        "scopeName": "markdown.pys.codeblock",
        "path": "./syntaxes/pys.markdown.codeblock.json",
        "injectTo": [
          "text.html.markdown",
          "source.mdx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pys": "pys"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/pys-markdown.css"
    ],
    "semanticTokenTypes": [
      {
        "id": "pysType",
        "description": "Validated PYS user or library type"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "pys",
        "scopes": {
          "pysType": ["entity.name.type.class.pys"]
        }
      }
    ],
    "snippets": [
      {
        "language": "pys",
        "path": "./snippets/pys.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "pys.runFile",
        "title": "Run File",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugFile",
        "title": "Debug File",
        "category": "PYS",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pys.runMain",
        "title": "Run Main File",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugMain",
        "title": "Debug Main File",
        "category": "PYS",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pys.setAsMainFile",
        "title": "Set as Main File",
        "category": "PYS"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@0"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "pys.runMain",
          "when": "pys.hasMainFile && !isInDiffEditor",
          "group": "navigation@2"
        },
        {
          "command": "pys.debugMain",
          "when": "pys.hasMainFile && !isInDiffEditor",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@100"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@101"
        }
      ],
      "editor/context": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@1"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@2"
        },
        {
          "command": "pys.setAsMainFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@1"
        },
        {
          "command": "pys.setAsMainFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pys.runMain",
          "when": "pys.hasMainFile"
        },
        {
          "command": "pys.debugMain",
          "when": "pys.hasMainFile"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pys.runFile",
        "key": "ctrl+shift+r",
        "when": "resourceExtname == .pys"
      },
      {
        "command": "pys.debugFile",
        "key": "ctrl+shift+d",
        "when": "resourceExtname == .pys"
      },
      {
        "command": "pys.runMain",
        "key": "ctrl+alt+r",
        "when": "pys.hasMainFile"
      },
      {
        "command": "pys.debugMain",
        "key": "ctrl+alt+d",
        "when": "pys.hasMainFile"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pys",
    "onLanguage:markdown",
    "onCommand:pys.runFile",
    "onCommand:pys.debugFile",
    "onCommand:pys.runMain",
    "onCommand:pys.debugMain",
    "onCommand:pys.setAsMainFile",
    "onStartupFinished"
  ]
}
