{
  "name": "pys-language",
  "displayName": "PYS Language Support",
  "description": "Syntax highlighting, snippets, diagnostics, and run/debug for the PYS teaching language.",
  "version": "0.0.14",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pys",
        "aliases": ["PYS", "pys"],
        "extensions": [".pys"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pys",
        "scopeName": "source.pys",
        "path": "./syntaxes/pys.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pys",
        "path": "./snippets/pys.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "pys.runFile",
        "title": "PYS: Run File",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugFile",
        "title": "PYS: Debug File",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pys.runFile",
          "when": "resourceLangId == pys",
          "group": "navigation"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceLangId == pys",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "pys.runFile",
          "when": "resourceLangId == pys",
          "group": "navigation"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceLangId == pys",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pys.runFile",
          "when": "resourceLangId == pys",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pys.runFile",
        "key": "ctrl+shift+r",
        "when": "editorLangId == pys"
      },
      {
        "command": "pys.debugFile",
        "key": "ctrl+shift+d",
        "when": "editorLangId == pys"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pys",
    "onCommand:pys.runFile",
    "onCommand:pys.debugFile"
  ]
}
