{
  "name": "pys-language",
  "displayName": "PYS Language Support",
  "description": "Syntax highlighting, snippets, diagnostics, and run/debug for the PYS teaching language.",
  "version": "0.0.23",
  "publisher": "local",
  "private": true,
  "scripts": {},
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "configuration": {
      "title": "PYS",
      "properties": {
        "pys.libraryTyping.usageTips": {
          "type": "boolean",
          "default": false,
          "description": "Show optional tips for using weakly typed Python library values in a typed way (for example typed loop variables)."
        }
      }
    },
    "languages": [
      {
        "id": "pys",
        "aliases": ["PYS", "pys"],
        "extensions": [".pys"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pys",
        "scopeName": "source.pys",
        "path": "./syntaxes/pys.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "pysType",
        "description": "Validated PYS user or library type"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "pys",
        "scopes": {
          "pysType": ["entity.name.type.class.pys"]
        }
      }
    ],
    "snippets": [
      {
        "language": "pys",
        "path": "./snippets/pys.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "pys.runFile",
        "title": "Run File",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugFile",
        "title": "Debug File",
        "category": "PYS",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@0"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@100"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@101"
        }
      ],
      "editor/context": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@1"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pys.runFile",
        "key": "ctrl+shift+r",
        "when": "resourceExtname == .pys"
      },
      {
        "command": "pys.debugFile",
        "key": "ctrl+shift+d",
        "when": "resourceExtname == .pys"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pys",
    "onCommand:pys.runFile",
    "onCommand:pys.debugFile"
  ]
}
