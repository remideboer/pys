{
  "name": "pys-language",
  "displayName": "PYS Language Support",
  "description": "Syntax highlighting, snippets, and Run for the PYS teaching language (transpiler bundled; pys.deps for libraries).",
  "version": "0.0.57",
  "publisher": "remideboer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/remideboer/pys.git"
  },
  "bugs": {
    "url": "https://github.com/remideboer/pys/issues"
  },
  "homepage": "https://github.com/remideboer/pys#readme",
  "icon": "icons/pys-icon.png",
  "keywords": [
    "pys",
    "teaching",
    "education",
    "transpiler",
    "python"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepare-bundle": "node scripts/prepare-bundle.js",
    "prepare": "npm run prepare-bundle",
    "vscode:prepublish": "npm run prepare-bundle",
    "package": "npm run prepare-bundle && npx --no-install vsce package",
    "package:elo": "npm run package && python scripts/prepare_elo_zip.py",
    "publish:marketplace": "npm run prepare-bundle && npx --no-install vsce publish",
    "publish:open-vsx": "npx --no-install ovsx publish"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "PYS",
      "properties": {
        "pys.mainFile": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative path to the main .pys entry file (for example examples/main.pys). Used by Run/Debug Main."
        },
        "pys.libraryTyping.usageTips": {
          "type": "boolean",
          "default": false,
          "description": "Show optional tips for using weakly typed Python library values in a typed way (for example typed loop variables)."
        },
        "pys.debug.inlineValues": {
          "type": "boolean",
          "default": true,
          "description": "Show current variable values inline in the .pys editor while debugging (IntelliJ-style)."
        }
      }
    },
    "languages": [
      {
        "id": "pys",
        "aliases": [
          "PYS",
          "pys"
        ],
        "extensions": [
          ".pys"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pys-logo.svg",
          "dark": "./icons/pys-logo.svg"
        }
      }
    ],
    "breakpoints": [
      {
        "language": "pys"
      }
    ],
    "grammars": [
      {
        "language": "pys",
        "scopeName": "source.pys",
        "path": "./syntaxes/pys.tmLanguage.json"
      },
      {
        "scopeName": "markdown.pys.codeblock",
        "path": "./syntaxes/pys.markdown.codeblock.json",
        "injectTo": [
          "text.html.markdown",
          "source.mdx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pys": "pys"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/pys-markdown.css"
    ],
    "semanticTokenTypes": [
      {
        "id": "pysType",
        "description": "Validated PYS user or library type"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "pys",
        "scopes": {
          "pysType": [
            "entity.name.type.class.pys"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "pys",
        "path": "./snippets/pys.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "pys.runFile",
        "title": "Run File",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugFile",
        "title": "Debug File",
        "category": "PYS",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pys.runMain",
        "title": "Run Main File",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugMain",
        "title": "Debug Main File",
        "category": "PYS",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pys.setAsMainFile",
        "title": "Set as Main File",
        "category": "PYS"
      },
      {
        "command": "pys.clearAllBreakpoints",
        "title": "Clear All Breakpoints",
        "category": "PYS",
        "icon": "$(clear-all)"
      },
      {
        "command": "pys.addLogpoint",
        "title": "Add Logpoint",
        "category": "PYS",
        "icon": "$(debug-breakpoint-log)"
      },
      {
        "command": "pys.findUsages",
        "title": "Find Usages",
        "category": "PYS",
        "icon": "$(references)"
      },
      {
        "command": "pys.refactor.rename",
        "title": "Rename Symbol",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.extractVariable",
        "title": "Extract Variable",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.extractFunction",
        "title": "Extract Function",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.inlineVariable",
        "title": "Inline Variable",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.inlineFunction",
        "title": "Inline Function",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.safeDelete",
        "title": "Safe Delete",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.introduceParameter",
        "title": "Introduce Parameter",
        "category": "PYS Refactor"
      }
    ],
    "submenus": [
      {
        "id": "pys.refactor.submenu",
        "label": "Refactor"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@0"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "pys.runMain",
          "when": "pys.hasMainFile && !isInDiffEditor",
          "group": "navigation@2"
        },
        {
          "command": "pys.debugMain",
          "when": "pys.hasMainFile && !isInDiffEditor",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@100"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@101"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@102"
        }
      ],
      "editor/title/context": [
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys",
          "group": "debug@1"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "debug@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "pys.refactor.submenu",
          "when": "resourceExtname == .pys",
          "group": "z_commands@0"
        },
        {
          "command": "pys.findUsages",
          "when": "resourceExtname == .pys",
          "group": "navigation@0"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@1"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@2"
        },
        {
          "command": "pys.addLogpoint",
          "when": "resourceExtname == .pys",
          "group": "navigation@3"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys",
          "group": "navigation@4"
        },
        {
          "command": "pys.setAsMainFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@5"
        }
      ],
      "pys.refactor.submenu": [
        {
          "command": "pys.refactor.rename",
          "group": "1_modify@1"
        },
        {
          "command": "pys.refactor.extractVariable",
          "group": "1_modify@2"
        },
        {
          "command": "pys.refactor.extractFunction",
          "group": "1_modify@3"
        },
        {
          "command": "pys.refactor.inlineVariable",
          "group": "1_modify@4"
        },
        {
          "command": "pys.refactor.inlineFunction",
          "group": "1_modify@5"
        },
        {
          "command": "pys.refactor.safeDelete",
          "group": "1_modify@6"
        },
        {
          "command": "pys.refactor.introduceParameter",
          "group": "1_modify@7"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "pys.addLogpoint",
          "when": "resourceExtname == .pys",
          "group": "debug@1"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys",
          "group": "debug@2"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "debug@3"
        }
      ],
      "explorer/context": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@1"
        },
        {
          "command": "pys.setAsMainFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pys.runMain",
          "when": "pys.hasMainFile"
        },
        {
          "command": "pys.debugMain",
          "when": "pys.hasMainFile"
        },
        {
          "command": "pys.addLogpoint",
          "when": "resourceExtname == .pys || editorLangId == pys"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys || editorLangId == pys"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pys.runFile",
        "key": "ctrl+shift+r",
        "when": "resourceExtname == .pys"
      },
      {
        "command": "pys.debugFile",
        "key": "ctrl+shift+d",
        "when": "resourceExtname == .pys"
      },
      {
        "command": "pys.runMain",
        "key": "ctrl+alt+r",
        "when": "pys.hasMainFile"
      },
      {
        "command": "pys.debugMain",
        "key": "ctrl+alt+d",
        "when": "pys.hasMainFile"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pys",
    "onLanguage:markdown",
    "onCommand:pys.runFile",
    "onCommand:pys.debugFile",
    "onCommand:pys.runMain",
    "onCommand:pys.debugMain",
    "onCommand:pys.setAsMainFile",
    "onCommand:pys.clearAllBreakpoints",
    "onCommand:pys.addLogpoint",
    "onStartupFinished"
  ],
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "ovsx": "1.0.2"
  }
}
