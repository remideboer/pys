{
  "name": "pys-language",
  "displayName": "PYS Language Support",
  "description": "Syntax highlighting, snippets, and Run for the PYS teaching language (transpiler bundled; pys.toml for libraries).",
  "version": "0.0.101",
  "publisher": "remideboer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/remideboer/pys.git"
  },
  "bugs": {
    "url": "https://github.com/remideboer/pys/issues"
  },
  "homepage": "https://github.com/remideboer/pys#readme",
  "icon": "icons/pys-icon.png",
  "keywords": [
    "pys",
    "teaching",
    "education",
    "transpiler",
    "python"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "apply-syntax-colors": "node scripts/apply-syntax-colors.js",
    "prepare-bundle": "node scripts/prepare-bundle.js",
    "prepare": "npm run prepare-bundle",
    "vscode:prepublish": "npm run prepare-bundle",
    "package": "npm run prepare-bundle && npx --no-install vsce package",
    "package:elo": "npm run package && python scripts/prepare_elo_zip.py",
    "publish:marketplace": "npm run prepare-bundle && npx --no-install vsce publish",
    "publish:open-vsx": "npx --no-install ovsx publish"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "PYS",
      "properties": {
        "pys.mainFile": {
          "type": "string",
          "default": "",
          "description": "Deprecated fallback entry file used only when no pys.toml exists.",
          "deprecationMessage": "Use [project].main in pys.toml or PYS: Set as entrypoint."
        },
        "pys.libraryTyping.usageTips": {
          "type": "boolean",
          "default": false,
          "description": "Show optional tips for using weakly typed Python library values in a typed way (for example typed loop variables)."
        },
        "pys.debug.inlineValues": {
          "type": "boolean",
          "default": true,
          "description": "Show current variable values inline in the .pys editor while debugging (IntelliJ-style)."
        },
        "pys.navigateLibrarySources": {
          "type": "boolean",
          "default": false,
          "description": "Go to Definition may open Python sources from the locked pys.toml / pys.lock environment (imports library packages). Off by default (ADR-001). Requires a trusted workspace."
        },
        "pys.emitTarget": {
          "type": "string",
          "enum": [
            "python",
            "javascript"
          ],
          "default": "python",
          "description": "Backend used when running or debugging .pys files: Python (CPython / debugpy) or JavaScript (Node.js / js-debug)."
        },
        "pys.intellisense.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Analysis-driven IntelliSense: in-scope identifiers, member completion after `.`, and Create Class suggestions. Toggle from the status bar."
        },
        "pys.syntaxColors.comments": {
          "type": "string",
          "format": "color",
          "default": "#6272A4",
          "order": 20,
          "markdownDescription": "Color for comments (hex). Settings UI is text-only — open **[PYS: Customize Syntax Colors](command:pys.customizeSyntaxColors)** for a color square, picker, and **Use color** (live update). **Reset Setting** restores per-theme defaults."
        },
        "pys.syntaxColors.strings": {
          "type": "string",
          "format": "color",
          "default": "#007328",
          "order": 22,
          "markdownDescription": "Color for string literals (hex). Use **[PYS: Customize Syntax Colors](command:pys.customizeSyntaxColors)** for swatch + picker. **Reset Setting** restores defaults."
        },
        "pys.syntaxColors.numbers": {
          "type": "string",
          "format": "color",
          "default": "#FFB86C",
          "order": 21,
          "markdownDescription": "Color for numbers, booleans, and escapes (hex). Use **[PYS: Customize Syntax Colors](command:pys.customizeSyntaxColors)** for swatch + picker. **Reset Setting** restores defaults."
        },
        "pys.syntaxColors.functions": {
          "type": "string",
          "format": "color",
          "default": "#20AAE0",
          "order": 23,
          "markdownDescription": "Color for functions and methods (hex). Use **[PYS: Customize Syntax Colors](command:pys.customizeSyntaxColors)** for swatch + picker. **Reset Setting** restores defaults."
        },
        "pys.syntaxColors.types": {
          "type": "string",
          "format": "color",
          "default": "#20E0CA",
          "order": 24,
          "markdownDescription": "Color for types (classes, primitives, structs, …) (hex). Use **[PYS: Customize Syntax Colors](command:pys.customizeSyntaxColors)** for swatch + picker. **Reset Setting** restores defaults."
        },
        "pys.syntaxColors.languageConstants": {
          "type": "string",
          "format": "color",
          "default": "#BD93F9",
          "order": 25,
          "markdownDescription": "Color for `this` / `super` and named constants (hex). Use **[PYS: Customize Syntax Colors](command:pys.customizeSyntaxColors)** for swatch + picker. **Reset Setting** restores defaults."
        },
        "pys.syntaxColors.keywords": {
          "type": "string",
          "format": "color",
          "default": "#FF79C6",
          "order": 26,
          "markdownDescription": "Color for keywords, storage modifiers, and decorators (hex). Use **[PYS: Customize Syntax Colors](command:pys.customizeSyntaxColors)** for swatch + picker. **Reset Setting** restores defaults."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "[*Dark*]": {
          "textMateRules": [
            {
              "scope": [
                "comment.line.number-sign.pys",
                "comment.block.pys"
              ],
              "settings": {
                "foreground": "#6272A4"
              }
            },
            {
              "scope": [
                "constant.numeric.integer.pys",
                "constant.numeric.float.pys",
                "constant.numeric.hex.pys",
                "constant.numeric.binary.pys",
                "constant.language.pys",
                "constant.character.escape.pys"
              ],
              "settings": {
                "foreground": "#FFB86C"
              }
            },
            {
              "scope": [
                "string.quoted.double.pys",
                "string.quoted.single.pys"
              ],
              "settings": {
                "foreground": "#007328"
              }
            },
            {
              "scope": [
                "entity.name.function.pys",
                "support.function.pys"
              ],
              "settings": {
                "foreground": "#20AAE0"
              }
            },
            {
              "scope": [
                "storage.type.primitive.pys",
                "entity.name.type.pys",
                "entity.name.type.class.pys",
                "entity.name.type.interface.pys",
                "entity.name.type.struct.pys",
                "entity.name.type.data.pys",
                "entity.name.type.entity.pys",
                "entity.name.type.enum.pys"
              ],
              "settings": {
                "foreground": "#20E0CA"
              }
            },
            {
              "scope": [
                "variable.language.pys",
                "variable.other.constant.pys"
              ],
              "settings": {
                "foreground": "#BD93F9"
              }
            },
            {
              "scope": [
                "keyword.control.pys",
                "keyword.operator.pys",
                "storage.modifier.pys",
                "punctuation.definition.decorator.pys",
                "entity.name.function.decorator.pys",
                "meta.function.decorator.pys"
              ],
              "settings": {
                "foreground": "#FF79C6"
              }
            }
          ]
        },
        "[*Light*]": {
          "textMateRules": [
            {
              "scope": [
                "comment.line.number-sign.pys",
