{
  "name": "pys-language",
  "displayName": "PYS Language Support",
  "description": "Syntax highlighting, snippets, and Run for the PYS teaching language (transpiler bundled; pys.toml for libraries).",
  "version": "0.0.94",
  "publisher": "remideboer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/remideboer/pys.git"
  },
  "bugs": {
    "url": "https://github.com/remideboer/pys/issues"
  },
  "homepage": "https://github.com/remideboer/pys#readme",
  "icon": "icons/pys-icon.png",
  "keywords": [
    "pys",
    "teaching",
    "education",
    "transpiler",
    "python"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepare-bundle": "node scripts/prepare-bundle.js",
    "prepare": "npm run prepare-bundle",
    "vscode:prepublish": "npm run prepare-bundle",
    "package": "npm run prepare-bundle && npx --no-install vsce package",
    "package:elo": "npm run package && python scripts/prepare_elo_zip.py",
    "publish:marketplace": "npm run prepare-bundle && npx --no-install vsce publish",
    "publish:open-vsx": "npx --no-install ovsx publish"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "PYS",
      "properties": {
        "pys.mainFile": {
          "type": "string",
          "default": "",
          "description": "Deprecated fallback entry file used only when no pys.toml exists.",
          "deprecationMessage": "Use [project].main in pys.toml or PYS: Set as entrypoint."
        },
        "pys.libraryTyping.usageTips": {
          "type": "boolean",
          "default": false,
          "description": "Show optional tips for using weakly typed Python library values in a typed way (for example typed loop variables)."
        },
        "pys.debug.inlineValues": {
          "type": "boolean",
          "default": true,
          "description": "Show current variable values inline in the .pys editor while debugging (IntelliJ-style)."
        },
        "pys.navigateLibrarySources": {
          "type": "boolean",
          "default": false,
          "description": "Go to Definition may open Python sources from the locked pys.toml / pys.lock environment (imports library packages). Off by default (ADR-001). Requires a trusted workspace."
        },
        "pys.emitTarget": {
          "type": "string",
          "enum": ["python", "javascript"],
          "default": "python",
          "description": "Backend used when running or debugging .pys files: Python (CPython / debugpy) or JavaScript (Node.js / js-debug)."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "[*Dark*]": {
          "textMateRules": [
            {
              "scope": [
                "punctuation.definition.decorator.pys",
                "entity.name.function.decorator.pys",
                "meta.function.decorator.pys"
              ],
              "settings": {
                "foreground": "#FF79C6",
                "fontStyle": "bold"
              }
            }
          ]
        },
        "[*Light*]": {
          "textMateRules": [
            {
              "scope": [
                "punctuation.definition.decorator.pys",
                "entity.name.function.decorator.pys",
                "meta.function.decorator.pys"
              ],
              "settings": {
                "foreground": "#9A1B6B",
                "fontStyle": "bold"
              }
            }
          ]
        },
        "[*HighContrast*]": {
          "textMateRules": [
            {
              "scope": [
                "punctuation.definition.decorator.pys",
                "entity.name.function.decorator.pys",
                "meta.function.decorator.pys"
              ],
              "settings": {
                "foreground": "#FFFF00",
                "fontStyle": "bold"
              }
            }
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pys",
          "title": "PYS",
          "icon": "icons/pys-logo.svg"
        }
      ]
    },
    "views": {
      "pys": [
        {
          "id": "pys.sidebar",
          "name": "Project",
          "icon": "icons/pys-logo.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pys.sidebar",
        "contents": "Create a PYS project with source roots (`src` / `tests`) and a `pys.toml` (entrypoint, emit `target`, deps).\n\n[Create PYS Project](command:pys.createProject)\n\nPick Python or JavaScript; missing runtimes prompt an OS install. Right-click `pys.toml` → **Run Project**. After editing `[dependencies]`, use **Run Deps Lock**."
      }
    ],
    "languages": [
      {
        "id": "pys",
        "aliases": [
          "PYS",
          "pys"
        ],
        "extensions": [
          ".pys"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pys-light.svg",
          "dark": "./icons/pys-dark.svg"
        }
      }
    ],
    "breakpoints": [
      {
        "language": "pys"
      }
    ],
    "grammars": [
      {
        "language": "pys",
        "scopeName": "source.pys",
        "path": "./syntaxes/pys.tmLanguage.json"
      },
      {
        "scopeName": "markdown.pys.codeblock",
        "path": "./syntaxes/pys.markdown.codeblock.json",
        "injectTo": [
          "text.html.markdown",
          "source.mdx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pys": "pys"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/pys-markdown.css"
    ],
    "semanticTokenTypes": [
      {
        "id": "pysType",
        "description": "Validated PYS user or library type"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "pys",
        "scopes": {
          "pysType": [
            "entity.name.type.class.pys"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "pys",
        "path": "./snippets/pys.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "pys.runFile",
        "title": "Run File",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugFile",
        "title": "Debug File",
        "category": "PYS",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pys.debugTranspiledFile",
        "title": "Debug Transpiled Output",
        "category": "PYS Advanced",
        "icon": "$(symbol-file)"
      },
      {
        "command": "pys.runMain",
        "title": "Run Main File",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugMain",
        "title": "Debug Main File",
        "category": "PYS",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pys.createProject",
        "title": "Create PYS Project",
        "category": "PYS",
        "icon": "$(new-folder)"
      },
      {
        "command": "pys.runProject",
        "title": "Run Project",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.lockDeps",
        "title": "Run Deps Lock",
        "category": "PYS",
        "icon": "$(package)"
      },
      {
        "command": "pys.setAsEntrypoint",
        "title": "Set as entrypoint",
        "category": "PYS"
      },
      {
        "command": "pys.selectEmitTarget",
        "title": "Select Emit Target",
        "category": "PYS",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "pys.clearAllBreakpoints",
        "title": "Clear All Breakpoints",
        "category": "PYS",
        "icon": "$(clear-all)"
      },
      {
        "command": "pys.addLogpoint",
        "title": "Add Logpoint",
        "category": "PYS",
        "icon": "$(debug-breakpoint-log)"
      },
      {
        "command": "pys.enablePysOnlyStepping",
        "title": "PYS-only Stepping: Off (Click to Enable)",
        "category": "PYS",
        "icon": "$(filter)",
        "enablement": "pys.debugSessionActive"
      },
      {
        "command": "pys.disablePysOnlyStepping",
        "title": "PYS-only Stepping: On (Click to Disable)",
        "category": "PYS",
        "icon": "$(filter-filled)",
        "enablement": "pys.debugSessionActive"
      },
      {
        "command": "pys.findUsages",
        "title": "Find Usages",
        "category": "PYS",
        "icon": "$(references)"
      },
      {
        "command": "pys.moveToSuggestedPackagePath",
        "title": "Move File to Suggested Package Path",
        "category": "PYS"
      },
      {
        "command": "pys.refactor.rename",
        "title": "Rename",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.extractVariable",
        "title": "Extract Variable",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.extractFunction",
        "title": "Extract Function",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.inlineVariable",
        "title": "Inline Variable",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.inlineFunction",
        "title": "Inline Function",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.safeDelete",
        "title": "Safe Delete",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.introduceParameter",
        "title": "Introduce Parameter",
        "category": "PYS Refactor"
      }
    ],
    "submenus": [
      {
        "id": "pys.refactor.more",
        "label": "More Refactorings"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "pys.enablePysOnlyStepping",
          "when": "pys.debugSessionActive && !pys.debug.pysOnlyStepping",
          "group": "navigation@100"
        },
        {
          "command": "pys.disablePysOnlyStepping",
          "when": "pys.debugSessionActive && pys.debug.pysOnlyStepping",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "pys.createProject",
          "when": "view == pys.sidebar",
          "group": "navigation@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@0"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "pys.runMain",
          "when": "pys.hasMainFile && !isInDiffEditor",
          "group": "navigation@2"
        },
        {
          "command": "pys.debugMain",
          "when": "pys.hasMainFile && !isInDiffEditor",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "pys.runProject",
          "when": "resourceFilename == 'pys.toml' && !isInDiffEditor",
          "group": "navigation@99"
        },
        {
          "command": "pys.lockDeps",
          "when": "(resourceFilename == 'pys.toml' || resourceFilename == 'pys.deps') && !isInDiffEditor",
          "group": "navigation@100"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@100"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@101"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@102"
        }
      ],
      "editor/title/context": [
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys",
          "group": "debug@1"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "debug@2"
        },
        {
          "command": "pys.debugTranspiledFile",
          "when": "resourceExtname == .pys",
          "group": "debug@3"
        }
      ],
      "editor/context": [
        {
          "command": "pys.runProject",
          "when": "resourceFilename == 'pys.toml'",
          "group": "navigation@0"
        },
        {
          "command": "pys.lockDeps",
          "when": "resourceFilename == 'pys.toml' || resourceFilename == 'pys.deps'",
          "group": "navigation@1"
        },
        {
          "command": "pys.refactor.rename",
          "when": "resourceExtname == .pys",
          "group": "pys.refactor@1"
        },
        {
          "command": "pys.refactor.extractVariable",
          "when": "resourceExtname == .pys",
          "group": "pys.refactor@2"
        },
        {
          "command": "pys.refactor.extractFunction",
          "when": "resourceExtname == .pys",
          "group": "pys.refactor@3"
        },
        {
          "submenu": "pys.refactor.more",
          "when": "resourceExtname == .pys",
          "group": "pys.refactor@4"
        },
        {
          "command": "pys.findUsages",
          "when": "resourceExtname == .pys",
          "group": "navigation@0"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@1"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@2"
        },
        {
          "command": "pys.debugTranspiledFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@2.5"
        },
        {
          "command": "pys.addLogpoint",
          "when": "resourceExtname == .pys",
          "group": "navigation@3"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys",
          "group": "navigation@4"
        },
        {
          "command": "pys.setAsEntrypoint",
          "when": "resourceExtname == .pys",
          "group": "navigation@5"
        }
      ],
      "pys.refactor.more": [
        {
          "command": "pys.refactor.inlineVariable",
          "group": "1_modify@1"
        },
        {
          "command": "pys.refactor.inlineFunction",
          "group": "1_modify@2"
        },
        {
          "command": "pys.refactor.safeDelete",
          "group": "1_modify@3"
        },
        {
          "command": "pys.refactor.introduceParameter",
          "group": "1_modify@4"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "pys.addLogpoint",
          "when": "resourceExtname == .pys",
          "group": "debug@1"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys",
          "group": "debug@2"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "debug@3"
        }
      ],
      "explorer/context": [
        {
          "command": "pys.runProject",
          "when": "resourceFilename == 'pys.toml'",
          "group": "navigation@0"
        },
        {
          "command": "pys.lockDeps",
          "when": "resourceFilename == 'pys.toml' || resourceFilename == 'pys.deps'",
          "group": "navigation@1"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@1"
        },
        {
          "command": "pys.setAsEntrypoint",
          "when": "resourceExtname == .pys",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pys.createProject"
        },
        {
          "command": "pys.runProject",
          "when": "resourceFilename == 'pys.toml'"
        },
        {
          "command": "pys.lockDeps",
          "when": "resourceFilename == 'pys.toml' || resourceFilename == 'pys.deps'"
        },
        {
          "command": "pys.debugTranspiledFile",
          "when": "resourceExtname == .pys || editorLangId == pys"
        },
        {
          "command": "pys.runMain",
          "when": "pys.hasMainFile"
        },
        {
          "command": "pys.debugMain",
          "when": "pys.hasMainFile"
        },
        {
          "command": "pys.addLogpoint",
          "when": "resourceExtname == .pys || editorLangId == pys"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys || editorLangId == pys"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pys.runFile",
        "key": "ctrl+shift+r",
        "when": "resourceExtname == .pys"
      },
      {
        "command": "pys.debugFile",
        "key": "ctrl+shift+d",
        "when": "resourceExtname == .pys"
      },
      {
        "command": "pys.runMain",
        "key": "ctrl+alt+r",
        "when": "pys.hasMainFile"
      },
      {
        "command": "pys.debugMain",
        "key": "ctrl+alt+d",
        "when": "pys.hasMainFile"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pys",
    "onLanguage:markdown",
    "onCommand:pys.runFile",
    "onCommand:pys.debugFile",
    "onCommand:pys.debugTranspiledFile",
    "onCommand:pys.runMain",
    "onCommand:pys.debugMain",
    "onCommand:pys.setAsEntrypoint",
    "onCommand:pys.setAsMainFile",
    "onCommand:pys.createProject",
    "onCommand:pys.runProject",
    "onCommand:pys.lockDeps",
    "onCommand:pys.clearAllBreakpoints",
    "onCommand:pys.addLogpoint",
    "onCommand:pys.enablePysOnlyStepping",
    "onCommand:pys.disablePysOnlyStepping",
    "onView:pys.sidebar",
    "onStartupFinished"
  ],
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "ovsx": "1.0.2"
  }
}
