                "constant.numeric.binary.pys",
                "constant.language.pys",
                "constant.character.escape.pys"
              ],
              "settings": {
                "foreground": "#A34D14"
              }
            },
            {
              "scope": [
                "string.quoted.double.pys",
                "string.quoted.single.pys"
              ],
              "settings": {
                "foreground": "#846E15"
              }
            },
            {
              "scope": [
                "entity.name.function.pys",
                "support.function.pys"
              ],
              "settings": {
                "foreground": "#14710A"
              }
            },
            {
              "scope": [
                "storage.type.primitive.pys",
                "entity.name.type.pys",
                "entity.name.type.class.pys",
                "entity.name.type.interface.pys",
                "entity.name.type.struct.pys",
                "entity.name.type.data.pys",
                "entity.name.type.entity.pys",
                "entity.name.type.enum.pys"
              ],
              "settings": {
                "foreground": "#036A96"
              }
            },
            {
              "scope": [
                "variable.language.pys",
                "variable.other.constant.pys"
              ],
              "settings": {
                "foreground": "#644AC9"
              }
            },
            {
              "scope": [
                "keyword.control.pys",
                "keyword.operator.pys",
                "storage.modifier.pys",
                "punctuation.definition.decorator.pys",
                "entity.name.function.decorator.pys",
                "meta.function.decorator.pys"
              ],
              "settings": {
                "foreground": "#A3144D"
              }
            }
          ]
        },
        "[*HighContrast*]": {
          "textMateRules": [
            {
              "scope": [
                "comment.line.number-sign.pys",
                "comment.block.pys"
              ],
              "settings": {
                "foreground": "#9AA5CE"
              }
            },
            {
              "scope": [
                "constant.numeric.integer.pys",
                "constant.numeric.float.pys",
                "constant.numeric.hex.pys",
                "constant.numeric.binary.pys",
                "constant.language.pys",
                "constant.character.escape.pys"
              ],
              "settings": {
                "foreground": "#FFB86C"
              }
            },
            {
              "scope": [
                "string.quoted.double.pys",
                "string.quoted.single.pys"
              ],
              "settings": {
                "foreground": "#01720C"
              }
            },
            {
              "scope": [
                "entity.name.function.pys",
                "support.function.pys"
              ],
              "settings": {
                "foreground": "#1575BE"
              }
            },
            {
              "scope": [
                "storage.type.primitive.pys",
                "entity.name.type.pys",
                "entity.name.type.class.pys",
                "entity.name.type.interface.pys",
                "entity.name.type.struct.pys",
                "entity.name.type.data.pys",
                "entity.name.type.entity.pys",
                "entity.name.type.enum.pys"
              ],
              "settings": {
                "foreground": "#00FFFF"
              }
            },
            {
              "scope": [
                "variable.language.pys",
                "variable.other.constant.pys"
              ],
              "settings": {
                "foreground": "#BD93F9"
              }
            },
            {
              "scope": [
                "keyword.control.pys",
                "keyword.operator.pys",
                "storage.modifier.pys",
                "punctuation.definition.decorator.pys",
                "entity.name.function.decorator.pys",
                "meta.function.decorator.pys"
              ],
              "settings": {
                "foreground": "#FF79C6",
                "fontStyle": "bold"
              }
            }
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pys",
          "title": "PYS",
          "icon": "icons/pys-logo.svg"
        }
      ]
    },
    "views": {
      "pys": [
        {
          "id": "pys.sidebar",
          "name": "Project",
          "icon": "icons/pys-logo.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pys.sidebar",
        "contents": "Create a PYS project with source roots (`src` / `tests`) and a `pys.toml` (entrypoint, emit `target`, deps).\n\n[Create PYS Project](command:pys.createProject)\n\nPick Python or JavaScript; missing runtimes prompt an OS install. Right-click `pys.toml` → **Run Project**. After editing `[dependencies]`, use **Run Deps Lock**."
      }
    ],
    "languages": [
      {
        "id": "pys",
        "aliases": [
          "PYS",
          "pys"
        ],
        "extensions": [
          ".pys"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pys-light.svg",
          "dark": "./icons/pys-dark.svg"
        }
      }
    ],
    "breakpoints": [
      {
        "language": "pys"
      }
    ],
    "grammars": [
      {
        "language": "pys",
        "scopeName": "source.pys",
        "path": "./syntaxes/pys.tmLanguage.json"
      },
      {
        "scopeName": "markdown.pys.codeblock",
        "path": "./syntaxes/pys.markdown.codeblock.json",
        "injectTo": [
          "text.html.markdown",
          "source.mdx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pys": "pys"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/pys-markdown.css"
    ],
    "semanticTokenTypes": [
      {
        "id": "pysType",
        "description": "Validated PYS user or library type"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "pys",
        "scopes": {
          "pysType": [
            "entity.name.type.class.pys"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "pys",
        "path": "./snippets/pys.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "pys.runFile",
        "title": "Run File",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugFile",
        "title": "Debug File",
        "category": "PYS",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pys.debugTranspiledFile",
        "title": "Debug Transpiled Output",
        "category": "PYS Advanced",
        "icon": "$(symbol-file)"
      },
      {
        "command": "pys.runMain",
        "title": "Run Main File",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.debugMain",
        "title": "Debug Main File",
        "category": "PYS",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pys.createProject",
        "title": "Create PYS Project",
        "category": "PYS",
        "icon": "$(new-folder)"
      },
      {
        "command": "pys.runProject",
        "title": "Run Project",
        "category": "PYS",
        "icon": "$(play)"
      },
      {
        "command": "pys.lockDeps",
        "title": "Run Deps Lock",
        "category": "PYS",
        "icon": "$(package)"
      },
      {
        "command": "pys.setAsEntrypoint",
        "title": "Set as entrypoint",
        "category": "PYS"
      },
      {
        "command": "pys.selectEmitTarget",
        "title": "Select Emit Target",
        "category": "PYS",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "pys.clearAllBreakpoints",
        "title": "Clear All Breakpoints",
        "category": "PYS",
        "icon": "$(clear-all)"
      },
      {
        "command": "pys.addLogpoint",
        "title": "Add Logpoint",
        "category": "PYS",
        "icon": "$(debug-breakpoint-log)"
      },
      {
        "command": "pys.enablePysOnlyStepping",
        "title": "PYS-only Stepping: Off (Click to Enable)",
