      },
      {
        "command": "pys.generate.toString",
        "title": "toString…",
        "category": "PYS Generate",
        "enablement": "false"
      },
      {
        "command": "pys.generate.overrideMethods",
        "title": "Override Methods…",
        "category": "PYS Generate",
        "enablement": "false"
      },
      {
        "command": "pys.generate.gettersSetters",
        "title": "Getters/Setters…",
        "category": "PYS Generate",
        "enablement": "false"
      },
      {
        "command": "pys.generate.test",
        "title": "Test…",
        "category": "PYS Generate",
        "enablement": "false"
      }
    ],
    "submenus": [
      {
        "id": "pys.refactor.more",
        "label": "Refactor"
      },
      {
        "id": "pys.generate",
        "label": "Generate"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "pys.enablePysOnlyStepping",
          "when": "pys.debugSessionActive && !pys.debug.pysOnlyStepping",
          "group": "navigation@100"
        },
        {
          "command": "pys.disablePysOnlyStepping",
          "when": "pys.debugSessionActive && pys.debug.pysOnlyStepping",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "pys.createProject",
          "when": "view == pys.sidebar",
          "group": "navigation@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@0"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "pys.runMain",
          "when": "pys.hasMainFile && !isInDiffEditor",
          "group": "navigation@2"
        },
        {
          "command": "pys.debugMain",
          "when": "pys.hasMainFile && !isInDiffEditor",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "pys.runProject",
          "when": "resourceFilename == 'pys.toml' && !isInDiffEditor",
          "group": "navigation@99"
        },
        {
          "command": "pys.lockDeps",
          "when": "(resourceFilename == 'pys.toml' || resourceFilename == 'pys.deps') && !isInDiffEditor",
          "group": "navigation@100"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@100"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@101"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys && !isInDiffEditor",
          "group": "navigation@102"
        }
      ],
      "editor/title/context": [
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys",
          "group": "debug@1"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "debug@2"
        },
        {
          "command": "pys.debugTranspiledFile",
          "when": "resourceExtname == .pys",
          "group": "debug@3"
        }
      ],
      "editor/context": [
        {
          "command": "pys.runProject",
          "when": "resourceFilename == 'pys.toml'",
          "group": "navigation@0"
        },
        {
          "command": "pys.lockDeps",
          "when": "resourceFilename == 'pys.toml' || resourceFilename == 'pys.deps'",
          "group": "navigation@1"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "0_run@1"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "0_run@2"
        },
        {
          "command": "pys.refactor.rename",
          "when": "resourceExtname == .pys",
          "group": "1_pys_refactor@1"
        },
        {
          "command": "pys.refactor.extractFunction",
          "when": "resourceExtname == .pys && !pys.inClassBody",
          "group": "1_pys_refactor@2"
        },
        {
          "command": "pys.refactor.extractMethod",
          "when": "resourceExtname == .pys && pys.inClassBody",
          "group": "1_pys_refactor@2"
        },
        {
          "submenu": "pys.refactor.more",
          "when": "resourceExtname == .pys",
          "group": "1_pys_refactor@3"
        },
        {
          "command": "pys.findUsages",
          "when": "resourceExtname == .pys",
          "group": "navigation@50"
        },
        {
          "submenu": "pys.generate",
          "when": "resourceExtname == .pys",
          "group": "z_pys_generate@1"
        },
        {
          "command": "revealFileInOS",
          "when": "resourceExtname == .pys && resourceScheme == file",
          "group": "z_pys_reveal@1"
        },
        {
          "command": "pys.debugTranspiledFile",
          "when": "resourceExtname == .pys",
          "group": "z_pys_extra@1"
        },
        {
          "command": "pys.addLogpoint",
          "when": "resourceExtname == .pys",
          "group": "z_pys_extra@2"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys",
          "group": "z_pys_extra@3"
        },
        {
          "command": "pys.setAsEntrypoint",
          "when": "resourceExtname == .pys",
          "group": "z_pys_extra@4"
        }
      ],
      "pys.refactor.more": [
        {
          "command": "pys.refactor.extractVariable",
          "group": "1_modify@1"
        },
        {
          "command": "pys.refactor.inlineVariable",
          "group": "1_modify@2"
        },
        {
          "command": "pys.refactor.inlineFunction",
          "group": "1_modify@3"
        },
        {
          "command": "pys.refactor.safeDelete",
          "group": "1_modify@4"
        },
        {
          "command": "pys.refactor.introduceParameter",
          "group": "1_modify@5"
        }
      ],
      "pys.generate": [
        {
          "command": "pys.generate.constructor",
          "group": "1_gen@1"
        },
        {
          "command": "pys.generate.toString",
          "group": "1_gen@2"
        },
        {
          "command": "pys.generate.overrideMethods",
          "group": "1_gen@3"
        },
        {
          "command": "pys.generate.gettersSetters",
          "group": "1_gen@4"
        },
        {
          "command": "pys.generate.test",
          "group": "1_gen@5"
        },
        {
          "command": "pys.generate.createClass",
          "group": "1_gen@6"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "pys.addLogpoint",
          "when": "resourceExtname == .pys",
          "group": "debug@1"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys",
          "group": "debug@2"
        },
        {
          "command": "pys.debugFile",
          "when": "resourceExtname == .pys",
          "group": "debug@3"
        }
      ],
      "explorer/context": [
        {
          "command": "pys.runProject",
          "when": "resourceFilename == 'pys.toml'",
          "group": "navigation@0"
        },
        {
          "command": "pys.lockDeps",
          "when": "resourceFilename == 'pys.toml' || resourceFilename == 'pys.deps'",
          "group": "navigation@1"
        },
        {
          "command": "pys.runFile",
          "when": "resourceExtname == .pys",
          "group": "navigation@1"
        },
        {
          "command": "pys.setAsEntrypoint",
          "when": "resourceExtname == .pys",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pys.createProject"
        },
        {
          "command": "pys.runProject",
          "when": "resourceFilename == 'pys.toml'"
        },
        {
          "command": "pys.lockDeps",
          "when": "resourceFilename == 'pys.toml' || resourceFilename == 'pys.deps'"
        },
        {
          "command": "pys.debugTranspiledFile",
          "when": "resourceExtname == .pys || editorLangId == pys"
        },
        {
          "command": "pys.runMain",
          "when": "pys.hasMainFile"
        },
        {
          "command": "pys.debugMain",
          "when": "pys.hasMainFile"
        },
        {
          "command": "pys.addLogpoint",
          "when": "resourceExtname == .pys || editorLangId == pys"
        },
        {
          "command": "pys.clearAllBreakpoints",
          "when": "resourceExtname == .pys || editorLangId == pys"
        },
        {
          "command": "pys.customizeSyntaxColors"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pys.runFile",
        "key": "ctrl+shift+r",
        "when": "resourceExtname == .pys"
      },
      {
        "command": "pys.debugFile",
        "key": "ctrl+shift+d",
        "when": "resourceExtname == .pys"
      },
      {
        "command": "pys.refactor.rename",
        "key": "f2",
        "when": "editorTextFocus && editorLangId == pys && !editorReadonly"
      },
      {
        "command": "pys.runMain",
        "key": "ctrl+alt+r",
        "when": "pys.hasMainFile"
      },
      {
        "command": "pys.debugMain",
        "key": "ctrl+alt+d",
        "when": "pys.hasMainFile"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pys",
    "onLanguage:markdown",
    "onCommand:pys.runFile",
    "onCommand:pys.debugFile",
    "onCommand:pys.debugTranspiledFile",
    "onCommand:pys.runMain",
    "onCommand:pys.debugMain",
    "onCommand:pys.setAsEntrypoint",
    "onCommand:pys.setAsMainFile",
    "onCommand:pys.createProject",
    "onCommand:pys.runProject",
    "onCommand:pys.lockDeps",
    "onCommand:pys.clearAllBreakpoints",
    "onCommand:pys.addLogpoint",
    "onCommand:pys.enablePysOnlyStepping",
    "onCommand:pys.disablePysOnlyStepping",
    "onView:pys.sidebar",
    "onStartupFinished"
  ],
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "ovsx": "1.0.2"
  }
}
