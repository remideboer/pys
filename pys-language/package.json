      },
      {
        "command": "pys.refactor.inlineFunction",
        "title": "Inline Function",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.safeDelete",
        "title": "Safe Delete",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.refactor.introduceParameter",
        "title": "Introduce Parameter",
        "category": "PYS Refactor"
      },
      {
        "command": "pys.toggleIntellisense",
        "title": "Toggle IntelliSense",
        "category": "PYS"
      },
      {
        "command": "pys.customizeSyntaxColors",
        "title": "Customize Syntax Colors",
        "category": "PYS",
        "icon": "$(symbol-color)"
      },
      {
        "command": "pys.generate.createClass",
        "title": "Create Class",
        "category": "PYS Generate"
      },
      {
        "command": "pys.generate.constructor",
        "title": "Constructor…",
        "category": "PYS Generate",
