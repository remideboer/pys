{
  "comments": {
    "lineComment": "#",
    "blockComment": ["##", "/#"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "##", "close": "/#" }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*\\{\\s*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:if|else if|else|unless|while|for|loop|function|func|class|interface|public|private|protected|module|global|package|const|fix|sealed|tasks|task|shared|atomic).*\\{\\s*$",
      "action": { "indentAction": "Indent" }
    },
    {
      "beforeText": "^\\s*\\{[^}]*$",
      "afterText": "^\\s*\\}",
      "action": { "indentAction": "IndentOutdent" }
    }
  ]
}
