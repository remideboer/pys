{
  "Inferred variable": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value}"
    ],
    "description": "Type-inferred variable (var)"
  },
  "Typed variable": {
    "prefix": "tvar",
    "body": [
      "${1|int,float,string,char,bool,byte,nibble,int16,int32,int64,dword|} ${2:name} = ${3:value}"
    ],
    "description": "Explicitly typed variable declaration"
  },
  "Binary literal": {
    "prefix": "0b",
    "body": [
      "0b${1:1010}"
    ],
    "description": "Binary integer literal"
  },
  "Hex literal": {
    "prefix": "0x",
    "body": [
      "0x${1:FF}"
    ],
    "description": "Hexadecimal integer literal"
  },
  "Function definition": {
    "prefix": "function",
    "body": [
      "function ${1:name}(${2:args}) {",
      "\t${0:print(\"\")}",
      "}"
    ],
    "description": "PYS function with brace body"
  },
  "Typed function": {
    "prefix": "functionret",
    "body": [
      "function ${1|int,float,string,char,bool|} ${2:name}(${3:args}) {",
      "\treturn ${0:0}",
      "}"
    ],
    "description": "PYS function with return type"
  },
  "Result function": {
    "prefix": "resultfn",
    "body": [
      "function result<${1:Value}, ${2:string}> ${3:name}(${4:args}) {",
      "\t${0:return ok(value)}",
      "}"
    ],
    "description": "PYS function returning a recoverable result"
  },
  "Nullable variable": {
    "prefix": "nullablevar",
    "body": [
      "nullable<${1:string}> ${2:name} = ${3:null}"
    ],
    "description": "Nullable value that may be absent (null)"
  },
  "Nullable function": {
    "prefix": "nullablefn",
    "body": [
      "function nullable<${1:Type}> ${2:name}(${3:args}) {",
      "\t${0:return null}",
      "}"
    ],
    "description": "Function that may return absence as null"
  },
  "Null check": {
    "prefix": "nullcheck",
    "body": [
      "if (${1:name} == null) {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "Handle absent nullable value before use"
  },
  "Handle result": {
    "prefix": "resultswitch",
    "body": [
      "switch (${1:outcome}) {",
      "\tcase ok(${2:value}):",
      "\t\t${3}",
      "\tcase err(${4:error}):",
      "\t\t${0}",
      "}"
    ],
    "description": "Exhaustively handle ok and err payloads"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "PYS if block"
  },
  "If / else": {
    "prefix": "ife",
    "body": [
      "if (${1:condition}) {",
      "\t${2}",
      "}",
      "else {",
      "\t${0}",
      "}"
    ],
    "description": "PYS if/else blocks"
  },
  "Unless": {
    "prefix": "unless",
    "body": [
      "unless (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "PYS unless block"
  },
  "Switch statement": {
    "prefix": "switch",
    "body": [
      "switch (${1:subject}) {",
      "\tcase ${2:LABEL}:",
      "\t\t${3}",
      "\tdefault:",
      "\t\t${0}",
      "}"
    ],
    "description": "PYS switch statement (multi-label / block body; continue = fall-through)"
  },
  "Switch expression": {
    "prefix": "switchexpr",
    "body": [
      "switch (${1:subject}) {",
      "\tcase ${2:LABEL} => ${3:value}",
      "\tdefault => ${0:value}",
      "}"
    ],
    "description": "PYS switch expression (multi-label with commas)"
  },
  "C-style loop": {
    "prefix": "loop",
    "body": [
      "loop (int ${1:i} = 0; ${1:i} < ${2:count}; ${1:i}++) {",
      "\t${0}",
      "}"
    ],
    "description": "PYS C-style for loop"
  },
  "While-style loop": {
    "prefix": "loopw",
    "body": [
      "loop (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "PYS while-style loop"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\tprivate ${2|string,int,float,bool|} ${3:field}",
      "",
      "\tpublic ${1:Name}(${2:string} ${3:field}) {",
      "\t\tthis.${3:field} = ${3:field}",
      "\t}",
      "",
      "\tpublic ${4:action}() {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "PYS class with constructor and method"
  },
  "Abstract class": {
    "prefix": "abstract",
    "body": [
      "abstract class ${1:Name} {",
      "\tpublic ${1:Name}() {",
      "\t\t${2}",
      "\t}",
      "",
      "\tpublic abstract ${3|int,string,bool,void,float|} ${4:method}(${5})",
      "\t${0}",
      "}"
    ],
    "description": "PYS abstract class with abstract method (no body)"
  },
  "Abstract method": {
    "prefix": "abstractmethod",
    "body": [
      "public abstract ${1|int,string,bool,void,float|} ${2:method}(${3})"
    ],
    "description": "PYS abstract method signature (inside abstract class)"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "${1|package,global,module|} struct ${2:Name} {",
      "\t${3|int,string,float,bool|} ${4:field}",
      "\t${0}",
      "}"
    ],
    "description": "PYS struct value type (fields always public)"
  },
  "Fix struct": {
    "prefix": "fixstruct",
    "body": [
      "fix struct ${1:Name} {",
      "\t${2|int,string,float,bool|} ${3:field}",
      "\t${0}",
      "}"
    ],
    "description": "Immutable PYS struct (all fields assign-once)"
  },
  "Data": {
    "prefix": "data",
    "body": [
      "${1|package,global,module|} data ${2:Name} {",
      "\t${3|int,string,float,bool|} ${4:field}",
      "\t${0}",
      "}"
    ],
    "description": "PYS data value object (immutable, structural equality)"
  },
  "Entity": {
    "prefix": "entity",
    "body": [
      "${1|package,global,module|} entity ${2:Name} identity(${3:id}) {",
      "\tprivate fix ${4|int,string|} ${3:id}",
      "\tpublic ${5|string,int|} ${6:field}",
      "",
      "\tpublic ${2:Name}(${4|int,string|} ${3:id}, ${5|string,int|} ${6:field}) {",
      "\t\tthis.${3:id} = ${3:id}",
      "\t\tthis.${6:field} = ${6:field}",
      "\t}",
      "\t${0}",
      "}"
    ],
    "description": "PYS entity with identity(...) key fields"
  },
  "Lambda binding": {
    "prefix": "lambda",
    "body": [
      "lambda<${1:int} -> ${2:bool}> ${3:name} = ${4:n} => ${5:n % 2 == 0}",
      "${0}"
    ],
    "description": "PYS lambda type binding (by-value capture)"
  },
  "Lambda arrow": {
    "prefix": "=>",
    "body": [
      "(${1:n}) => ${2:n}"
    ],
    "description": "PYS lambda expression"
  },
  "Atomic variable": {
    "prefix": "atomic",
    "body": [
      "atomic ${1|int,int16,int32,int64,dword,bool|} ${2:counter} = ${3:0}",
      "${0}"
    ],
    "description": "PYS atomic (indivisible RMW; implies shared for capture)"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "${1|package,global,module|} enum ${2:Name} {",
      "\t${3:MEMBER},",
      "\t${0:OTHER}",
      "}"
    ],
    "description": "PYS enum (comma-delimited; implicit auto values)"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\trequires ${2|string,int,bool|} ${3:field}",
      "",
      "\t${4|string,int,bool,void|} ${5:method}() {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "PYS trait with requires + method body"
  },
  "Class uses traits": {
    "prefix": "uses",
    "body": [
      "class ${1:Name} uses ${2:Trait}(${3:req}: ${4:hostMember}) {",
      "\tprivate ${5|string,int|} ${4:hostMember}",
      "",
      "\tpublic ${1:Name}(${5} ${4}) {",
      "\t\tthis.${4} = ${4}",
      "\t}",
      "\t${0}",
      "}"
    ],
    "description": "PYS class composing a trait via uses (optional requires remap)"
  },
  "Enum explicit": {
    "prefix": "enumx",
    "body": [
      "enum ${1:Name} {",
      "\t${2:MEMBER} = ${3:0},",
      "\t${0:OTHER} = ${4:1}",
      "}"
    ],
    "description": "PYS enum with explicit int/string values (comma-delimited)"
  },
  "Subclass": {
    "prefix": "inherits",
    "body": [
      "class ${1:Child} inherits ${2:Parent} {",
      "\tpublic ${1:Child}(${3:args}) {",
      "\t\tsuper(${4:args})",
      "\t}",
      "",
      "\tpublic ${5:action}() {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "PYS subclass using inherits"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "\t${2:action}(${3})",
      "}"
    ],
    "description": "PYS interface method signatures (always public; no access modifier)"
  },
  "Class implements": {
    "prefix": "implements",
    "body": [
      "class ${1:Name} implements ${2:Interface} {",
      "\tpublic ${1:Name}() {",
      "\t\t${0}",
      "\t}",
      "",
      "\tpublic ${3:action}() {",
      "\t\t",
      "\t}",
      "}"
    ],
    "description": "PYS class that implements an interface"
  },
  "Method": {
    "prefix": "method",
    "body": [
      "public ${1:name}(${2:args}) {",
      "\t${0}",
      "}"
    ],
    "description": "PYS class method with access modifier"
  },
  "Typed method": {
    "prefix": "methodret",
    "body": [
      "public ${1|int,float,string,char,bool|} ${2:name}(${3:args}) {",
      "\treturn ${0}",
      "}"
    ],
    "description": "PYS class method with return type"
  },
  "Import from": {
    "prefix": "importfrom",
    "body": [
      "import ${1:Name}${2:, Other} from ${3:module}"
    ],
    "description": "PYS import name(s) from module"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "print(\"${1:message}\")"
    ],
    "description": "PYS print statement"
  },
  "Interpolated string": {
    "prefix": "interp",
    "body": [
      "\"{${1:name}}\""
    ],
    "description": "String with interpolation"
  }
}
