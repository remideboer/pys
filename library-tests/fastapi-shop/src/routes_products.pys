# Product CRUD — GET open; writes require Bearer JWT.
# Domain: Product entity; HTTP JSON via productToDict (dict | JSONResponse at edge).

import APIRouter, Request from fastapi
import database, security from state
import withParam from paths
import readJson from json_body
import ShopDatabase from db
import Product from models
import productFromRow from mappers
import productToDict from views

APIRouter appRouter = APIRouter(tags=["products"])
string PRODUCT_ONE = withParam("/api/products/", "product_id")

function nullable<Product> loadProduct(int productId) {
    ShopDatabase db = database()
    MySQLCursor cur = db.cursor()
    cur.execute(
        "SELECT product_id, sku, name, unit_price, active, created_at "
        + "FROM product WHERE product_id=%s",
        (productId,)
    )
    nullable<tuple> row = cur.fetchone()
    cur.close()
    if (row == null) {
        return null
    }
    return productFromRow(row, db)
}

@appRouter.get("/api/products")
function list listProducts() {
    ShopDatabase db = database()
    MySQLCursor cur = db.cursor()
    cur.execute(
        "SELECT product_id, sku, name, unit_price, active, created_at "
        + "FROM product ORDER BY product_id"
    )
    list<tuple> rows = cur.fetchall()
    cur.close()
    list out = []
    loop (tuple row in rows) {
        out.append(productToDict(productFromRow(row, db)))
    }
    return out
}

@appRouter.get(PRODUCT_ONE)
function object getProduct(int product_id) {
    nullable<Product> found = loadProduct(product_id)
    if (found == null) {
        return security().notFound("product not found")
    }
    return productToDict(found)
}

@appRouter.post("/api/products")
function object createProduct(Request request) {
    nullable<dict> user = security().requireUser(request)
    if (user == null) {
        return security().unauthorized("bearer token required")
    }
    dict body = readJson(request)
    if (!("sku" in body) || !("name" in body) || !("unitPrice" in body)) {
        return security().badRequest("sku, name, unitPrice required")
    }
    string sku = str(body["sku"])
    string name = str(body["name"])
    float unitPrice = (float)(body["unitPrice"])
    if (sku == "" || name == "") {
        return security().badRequest("sku and name must be non-empty")
    }
    ShopDatabase db = database()
    MySQLCursor cur = db.cursor()
    cur.execute(
        "INSERT INTO product (sku, name, unit_price, active) VALUES (%s, %s, %s, 1)",
        (sku, name, unitPrice)
    )
    db.commit()
    int newId = int(cur.lastrowid)
    cur.close()
    nullable<Product> created = loadProduct(newId)
    if (created == null) {
        return security().notFound("product not found after insert")
    }
    return productToDict(created)
}

@appRouter.put(PRODUCT_ONE)
function object updateProduct(int product_id, Request request) {
    nullable<dict> user = security().requireUser(request)
    if (user == null) {
        return security().unauthorized("bearer token required")
    }
    dict body = readJson(request)
    nullable<Product> existing = loadProduct(product_id)
    if (existing == null) {
        return security().notFound("product not found")
    }
    Product row = existing
    string sku = row.sku
    string name = row.name
    float unitPrice = row.unitPrice
    bool active = row.active
    if ("sku" in body) {
        sku = str(body["sku"])
    }
    if ("name" in body) {
        name = str(body["name"])
    }
    if ("unitPrice" in body) {
        unitPrice = (float)(body["unitPrice"])
    }
    if ("active" in body) {
        active = (bool)(body["active"])
    }
    ShopDatabase db = database()
    MySQLCursor cur = db.cursor()
    cur.execute(
        "UPDATE product SET sku=%s, name=%s, unit_price=%s, active=%s WHERE product_id=%s",
        (sku, name, unitPrice, (int)(active), product_id)
    )
    db.commit()
    cur.close()
    nullable<Product> updated = loadProduct(product_id)
    if (updated == null) {
        return security().notFound("product not found")
    }
    return productToDict(updated)
}

@appRouter.delete(PRODUCT_ONE)
function object deleteProduct(int product_id, Request request) {
    nullable<dict> user = security().requireUser(request)
    if (user == null) {
        return security().unauthorized("bearer token required")
    }
    nullable<Product> existing = loadProduct(product_id)
    if (existing == null) {
        return security().notFound("product not found")
    }
    ShopDatabase db = database()
    MySQLCursor cur = db.cursor()
    cur.execute("DELETE FROM product WHERE product_id=%s", (product_id,))
    db.commit()
    cur.close()
    dict out = dict()
    out["deleted"] = true
    out["productId"] = product_id
    return out
}

package function APIRouter productsRouter() {
    return appRouter
}
