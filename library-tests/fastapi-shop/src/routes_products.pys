# Product CRUD — GET open; writes require Bearer JWT.

import APIRouter, Request from fastapi
import database, security from state
import withParam from paths
import readJson from json_body

object appRouter = APIRouter(tags=["products"])
string PRODUCT_ONE = withParam("/api/products/", "product_id")

function dict productRow(object row, object db) {
    dict out = dict()
    out["productId"] = db.cellInt(row[0])
    out["sku"] = db.cellStr(row[1])
    out["name"] = db.cellStr(row[2])
    out["unitPrice"] = db.cellFloat(row[3])
    out["active"] = db.cellBool(row[4])
    return out
}

function object loadProduct(int productId) {
    object db = database()
    object cur = db.cursor()
    cur.execute(
        "SELECT product_id, sku, name, unit_price, active FROM product WHERE product_id=%s",
        (productId,)
    )
    object row = cur.fetchone()
    cur.close()
    if (row == null) {
        return security().notFound("product not found")
    }
    return productRow(row, db)
}

@appRouter.get("/api/products")
function list listProducts() {
    object db = database()
    object cur = db.cursor()
    cur.execute(
        "SELECT product_id, sku, name, unit_price, active FROM product ORDER BY product_id"
    )
    list rows = cur.fetchall()
    cur.close()
    list out = []
    loop (row in rows) {
        out.append(productRow(row, db))
    }
    return out
}

@appRouter.get(PRODUCT_ONE)
function object getProduct(int product_id) {
    return loadProduct(product_id)
}

@appRouter.post("/api/products")
function object createProduct(Request request) {
    nullable<dict> user = security().requireUser(request)
    if (user == null) {
        return security().unauthorized("bearer token required")
    }
    object body = readJson(request)
    if (!("sku" in body) || !("name" in body) || !("unitPrice" in body)) {
        return security().badRequest("sku, name, unitPrice required")
    }
    string sku = str(body["sku"])
    string name = str(body["name"])
    float unitPrice = (float)(body["unitPrice"])
    if (sku == "" || name == "") {
        return security().badRequest("sku and name must be non-empty")
    }
    object db = database()
    object cur = db.cursor()
    cur.execute(
        "INSERT INTO product (sku, name, unit_price, active) VALUES (%s, %s, %s, 1)",
        (sku, name, unitPrice)
    )
    db.commit()
    int newId = int(cur.lastrowid)
    cur.close()
    return loadProduct(newId)
}

@appRouter.put(PRODUCT_ONE)
function object updateProduct(int product_id, Request request) {
    nullable<dict> user = security().requireUser(request)
    if (user == null) {
        return security().unauthorized("bearer token required")
    }
    object body = readJson(request)
    object existing = loadProduct(product_id)
    if (hasattr(existing, "status_code")) {
        return existing
    }
    dict row = existing
    string sku = str(row["sku"])
    string name = str(row["name"])
    float unitPrice = (float)(row["unitPrice"])
    bool active = (bool)(row["active"])
    if ("sku" in body) {
        sku = str(body["sku"])
    }
    if ("name" in body) {
        name = str(body["name"])
    }
    if ("unitPrice" in body) {
        unitPrice = (float)(body["unitPrice"])
    }
    if ("active" in body) {
        active = (bool)(body["active"])
    }
    object db = database()
    object cur = db.cursor()
    cur.execute(
        "UPDATE product SET sku=%s, name=%s, unit_price=%s, active=%s WHERE product_id=%s",
        (sku, name, unitPrice, (int)(active), product_id)
    )
    db.commit()
    cur.close()
    return loadProduct(product_id)
}

@appRouter.delete(PRODUCT_ONE)
function object deleteProduct(int product_id, Request request) {
    nullable<dict> user = security().requireUser(request)
    if (user == null) {
        return security().unauthorized("bearer token required")
    }
    object existing = loadProduct(product_id)
    if (hasattr(existing, "status_code")) {
        return existing
    }
    object db = database()
    object cur = db.cursor()
    cur.execute("DELETE FROM product WHERE product_id=%s", (product_id,))
    db.commit()
    cur.close()
    dict out = dict()
    out["deleted"] = true
    out["productId"] = product_id
    return out
}

package function object productsRouter() {
    return appRouter
}
