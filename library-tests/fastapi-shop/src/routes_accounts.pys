# Account directory + address/payment reads (password hashes never returned).

import APIRouter, Request from fastapi
import database, security from state
import withParam from paths
import ShopDatabase from db
import Account, AccountAddress, PaymentMethod from models
import accountPublicFromRow, addressFromRow, paymentFromRow from mappers
import accountToPublicDict, addressToDict, paymentToDict from views

APIRouter appRouter = APIRouter(tags=["accounts"])
string ACCOUNT_ONE = withParam("/api/accounts/", "account_id")
string ACCOUNT_ADDR = withParam("/api/accounts/", "account_id") + "/addresses"
string ACCOUNT_PAY = withParam("/api/accounts/", "account_id") + "/payments"

@appRouter.get("/api/accounts")
function list listAccounts() {
    ShopDatabase db = database()
    MySQLCursor cur = db.cursor()
    cur.execute(
        "SELECT account_id, username, display_name, email, role, active "
        + "FROM account ORDER BY account_id"
    )
    list<tuple> rows = cur.fetchall()
    cur.close()
    list out = []
    loop (tuple row in rows) {
        out.append(accountToPublicDict(accountPublicFromRow(row, db)))
    }
    return out
}

@appRouter.get("/api/accounts/me")
function object me(Request request) {
    nullable<dict> user = security().requireUser(request)
    if (user == null) {
        return security().unauthorized("bearer token required")
    }
    nullable<Account> accountN = security().findAccount(str(user["sub"]))
    if (accountN == null) {
        return security().notFound("account not found")
    }
    return accountToPublicDict(accountN)
}

@appRouter.get(ACCOUNT_ONE)
function object getAccount(int account_id) {
    ShopDatabase db = database()
    MySQLCursor cur = db.cursor()
    cur.execute(
        "SELECT account_id, username, display_name, email, role, active "
        + "FROM account WHERE account_id=%s",
        (account_id,)
    )
    nullable<tuple> row = cur.fetchone()
    cur.close()
    if (row == null) {
        return security().notFound("account not found")
    }
    return accountToPublicDict(accountPublicFromRow(row, db))
}

@appRouter.get(ACCOUNT_ADDR)
function object listAddresses(int account_id) {
    ShopDatabase db = database()
    MySQLCursor cur = db.cursor()
    cur.execute(
        "SELECT account_id FROM account WHERE account_id=%s",
        (account_id,)
    )
    if (cur.fetchone() == null) {
        cur.close()
        return security().notFound("account not found")
    }
    cur.execute(
        "SELECT address_id, address_kind, street, house_number, postal_code, city, country "
        + "FROM account_address WHERE account_id=%s ORDER BY address_id",
        (account_id,)
    )
    list<tuple> rows = cur.fetchall()
    cur.close()
    list out = []
    loop (tuple row in rows) {
        AccountAddress addr = addressFromRow(row, db)
        out.append(addressToDict(addr))
    }
    return out
}

@appRouter.get(ACCOUNT_PAY)
function object listPayments(int account_id) {
    ShopDatabase db = database()
    MySQLCursor cur = db.cursor()
    cur.execute(
        "SELECT account_id FROM account WHERE account_id=%s",
        (account_id,)
    )
    if (cur.fetchone() == null) {
        cur.close()
        return security().notFound("account not found")
    }
    cur.execute(
        "SELECT payment_method_id, method_type, label, iban, card_brand, card_last4, "
        + "exp_month, exp_year, is_default "
        + "FROM account_payment_method WHERE account_id=%s ORDER BY payment_method_id",
        (account_id,)
    )
    list<tuple> rows = cur.fetchall()
    cur.close()
    list out = []
    loop (tuple row in rows) {
        PaymentMethod pay = paymentFromRow(row, db)
        out.append(paymentToDict(pay))
    }
    return out
}

package function APIRouter accountsRouter() {
    return appRouter
}
