# Module-level wiring set by createApp before uvicorn starts.
# Dict holder so bind() can mutate without Python `global`.

import ServerConfig from config
import ShopDatabase from db
import Security from security

dict HOLDER = dict()
HOLDER["db"] = null
HOLDER["sec"] = null
HOLDER["cfg"] = null

package function void bind(ServerConfig cfg, ShopDatabase db, Security sec) {
    HOLDER["cfg"] = cfg
    HOLDER["db"] = db
    HOLDER["sec"] = sec
}

package function ShopDatabase database() {
    return HOLDER["db"]
}

package function Security security() {
    return HOLDER["sec"]
}

package function ServerConfig config() {
    return HOLDER["cfg"]
}
