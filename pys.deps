# Directions for the runner: where to find the interpreter and shared packages.
# No venv — packages live in the central repo (~/.pys/repository), Maven-style.

[interpreter]
	version: >=3.10
	# path: C:\Python311\python.exe

[dependencies]
	# version defaults to latest; stored once under ~/.pys/repository/packages/...
	# build: run | test  (optional; omitted = available for both)

	# Example packages (commented so examples run without network on first clone):
	# matplotlib
	# 	version: latest
	# 	build: run
	mysql-connector-python
		version: 8.0.33
		build: run
